    <width>50</width>
    <height>50</height>
    <text>Loop</text>
    <transparent>true</transparent>
    <border_width>3.0</border_width>
    <font>
        <font family = "Liberation Sans" style = "BOLD" size = "0">
        </font>
    </font>
    <actions>
      <action type = "open_display">
        <file>MCTF_MESON_LOOPS__VALVE_TEMPLATE.bob</file>
        <target>window</target>
        <description>Open Display</description>
        <macros>
          <Title>RED+REFRIGERATOR+EVX1+LOOP</Title>
          <DevName>F:CTVRX1</DevName>
          <LoopAutoMan>F:RRX1EN</LoopAutoMan>
          <InputDevice>F:CTRT2L</InputDevice>
          <LoopSetPoint>F:RRX1SP</LoopSetPoint>
          <DevSetManual>F:RRX1ST</DevSetManual>
          <DevCurrentValue>F:CTVRX1</DevCurrentValue>
          <LoopSetMin>F:RRX1MN</LoopSetMin>
