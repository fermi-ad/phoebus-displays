        <description>Open Display</description>
        <macros>
          <Title>YELLOW++WATER+VALVE+LOOP</Title>
          <DevName>F:CTVYCW</DevName>
          <LoopAutoMan>F:CYCWEN</LoopAutoMan>
          <InputDevice>F:CTYT32</InputDevice>
          <LoopSetPoint>F:CYCWSP</LoopSetPoint>
          <DevSetManual>F:CYCWSM</DevSetManual>
          <DevCurrentValue>F:CTVYCW</DevCurrentValue>
          <LoopSetMin>F:CYCWMN</LoopSetMin>
          <LoopSetMax>F:CYCWMX</LoopSetMax>
          <RemLocLoopStatus>F:CYCWRM</RemLocLoopStatus>
          <StrokeColor>yellow</StrokeColor>
          <BackColor>lightsteelblue</BackColor>
        </macros>
      </action>
    </actions>
  </widget>
