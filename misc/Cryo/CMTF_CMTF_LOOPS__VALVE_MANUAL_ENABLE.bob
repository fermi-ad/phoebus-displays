        <macros>
          <Title>ColdBox3+Max+Set+Point</Title>
          <DevName>C:3TS2MX</DevName>
          <DevSetManual>C:3TS2MX</DevSetManual>
          <DevCurrentValue>C:3TS2MR</DevCurrentValue>
          <DevEnable>C:3TS2ME</DevEnable>
          <Text1>ColdBox+3+Turbine+String+1+Inlet+Valve+Set+Maximum</Text1>
          <Color1>royalblue</Color1>
          <Text2>User+Set+Max+Input+Restricted+to:+50.0+to+100.0</Text2>
          <Color2>royalblue</Color2>
          <Text3>Set+(User+Set+Max)+in+Increments+of+1%25++50.0+51.0+52.0+etc.</Text3>
          <Color3>royalblue</Color3>
        </macros>
      </action>
    </actions>
