  <widget type = "action_button" version = "2.0.0">
    <name>action_button_3107</name>
    <x>187</x>
    <y>18</y>
    <width>109</width>
    <height>47</height>
    <text>Prufier Compressor</text>
    <transparent>true</transparent>
    <border_width>3.0</border_width>
    <foreground_color>
        <color name = "darkblue" red = "0" green = "0" blue = "139">
        </color>
    </foreground_color>
    <font>
        <font family = "Liberation Sans" style = "BOLD" size = "14">
        </font>
    </font>
    <actions>
      <action type = "open_display">
        <file>NML_Parts__Parts1.bob</file>
        <target>window</target>
        <description>Open Display</description>
        <macros>
          <Title>Meson+Purifier+Compressor</Title>
          <Name>Purifier+Compressor</Name>
          <LoSliderRead>Z:CTPLSL</LoSliderRead>
          <LoSliderMax>Z:CPLSMX</LoSliderMax>
          <LoSliderMin>Z:CPLSMN</LoSliderMin>
          <LoDevSetManual>Z:CPLSST</LoDevSetManual>
          <LoLoopSetPoint>Z:CPLSSP</LoLoopSetPoint>
          <LoInputDevice>Z:CTPSUC</LoInputDevice>
          <LoLoopAutoMan>Z:CPLSEN</LoLoopAutoMan>
          <CompLocal>Z:CPREM</CompLocal>
          <CompReady>Z:CPRDY</CompReady>
          <CompOn>Z:CTPCON</CompOn>
          <OilPumpOn>Z:CPPON</OilPumpOn>
          <StartComp>Z:CPSRT</StartComp>
          <ResetComp>Z:CPRST</ResetComp>
          <StopComp>Z:CPSTP</StopComp>
          <ReadBack1>Z:CTPSUC</ReadBack1>
          <ReadBack2>Z:CTPOIL</ReadBack2>
          <ReadBack3>Z:CTPINT</ReadBack3>
          <ReadBack4>Z:CTPDIS</ReadBack4>
          <ReadBack5>Z:CTTDDS</ReadBack5>
          <ReadBack6>Z:CTTD71</ReadBack6>
          <ReadBack7>Z:CTTD72</ReadBack7>
          <CompStatus1>Z:CPODL</CompStatus1>
          <CompStatus2>Z:CPSSC</CompStatus2>
          <CompStatus3>Z:CPOTH</CompStatus3>
          <CompStatus4>Z:CPDTH</CompStatus4>
          <CompStatus5>Z:CPDPH</CompStatus5>
          <CompStatus6>Z:CPCLH</CompStatus6>
          <CompStatus7>Z:CPUTE</CompStatus7>
          <CompStatus8>Z:CPSNR</CompStatus8>
          <CompStatus9>Z:CPCUL</CompStatus9>
          <CompStatus10>Z:CPESTP</CompStatus10>
          <FillColor>darkblue</FillColor>
          <TextColor>white</TextColor>
        </macros>
      </action>
    </actions>
  </widget>
