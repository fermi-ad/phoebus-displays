    <actions>
      <action type = "open_display">
        <file>Meson_MESON_LOOPS__VALVE_DUAL_NPUTS.bob</file>
        <target>window</target>
        <description>Open Display</description>
        <macros>
          <Title>STC+PVJ2K+VALVE</Title>
          <DevName>Z:HSPV2K</DevName>
          <LoopRem>Z:HS2KRM</LoopRem>
          <InputDevice>Z:HSPTS6</InputDevice>
          <InputDevice2>Z:HSPTS8</InputDevice2>
          <LoopSetPoint>Z:HS2KSP</LoopSetPoint>
          <DevSetManual>Z:HS2KSM</DevSetManual>
          <DevCurrentValue>Z:HSPV2K</DevCurrentValue>
          <LoopSetMin>Z:HS2KMN</LoopSetMin>
          <LoopSetMax>Z:HS2KMX</LoopSetMax>
          <SelectInput>Z:HS2KSL</SelectInput>
          <LoopAutoMan>Z:HS2KEN</LoopAutoMan>
          <SelectText>0.0%3DZ:HSPTS6+SELECTED%2C1.0%3DZ:HSPTS8+SELECTED</SelectText>
        </macros>
      </action>
    </actions>
  </widget>
