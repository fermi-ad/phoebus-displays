  <widget type = "action_button" version = "2.0.0">
    <name>action_button_1053</name>
    <x>407</x>
    <y>123</y>
    <width>135</width>
    <height>30</height>
    <text>BA1 CONTROLS</text>
    <transparent>true</transparent>
    <border_width>3.0</border_width>
    <foreground_color>
        <color name = "midnightblue" red = "25" green = "25" blue = "112">
        </color>
    </foreground_color>
    <font>
        <font family = "Liberation Sans" style = "BOLD" size = "14">
        </font>
    </font>
    <actions>
      <action type = "open_display">
        <file>HAB_HAB_Loops__Compressor_Control.bob</file>
        <target>window</target>
        <description>Open Display</description>
        <macros>
          <Title>BA1+Compressor</Title>
          <DevName>BA1+Compressor+Slider+Control</DevName>
          <HISLAUTO>T:BA1HSENA</HISLAUTO>
          <HISLINPUT>T:BA1PINT</HISLINPUT>
          <HISLOUT>T:BA1HISLSET</HISLOUT>
          <HISLSP>T:BA1HSSP</HISLSP>
          <HISLHI>T:BA1HSMAX</HISLHI>
          <HISLLOW>T:BA1HSMIN</HISLLOW>
          <HISLPOS>T:BA1HS</HISLPOS>
          <LOSLAUTO>T:BA1LSENA</LOSLAUTO>
          <LOSLINPUT>T:BAPTCMPR1SUC</LOSLINPUT>
          <LOSLOUT>T:BA1LOSLSET</LOSLOUT>
          <LOSLSP>T:BA1LSSP</LOSLSP>
          <LOSLHI>T:BA1LSMAX</LOSLHI>
          <LOSLLOW>T:BA1LSMIN</LOSLLOW>
          <LOSLPOS>T:BA1LS</LOSLPOS>
          <DischargePress>T:BA1PDIS</DischargePress>
          <OnStatus>T:BA1CON</OnStatus>
          <LocRemStatus>T:BA1REM</LocRemStatus>
          <HeartBeatStatus>T:BA1HB9</HeartBeatStatus>
          <ReadyStatus>T:BA1DRDY</ReadyStatus>
          <CoalescrHigh>T:BA1CLH</CoalescrHigh>
          <LoadingSts>T:BA1CUL</LoadingSts>
          <DischPressHigh>T:BA1DPH</DischPressHigh>
          <DischTempHigh>T:BA1DTH</DischTempHigh>
          <EstopSts>T:BA1ESTOP</EstopSts>
          <MotorStarterSts>T:BA1MSF</MotorStarterSts>
          <MotorTempHigh>T:BA1MTH</MotorTempHigh>
          <OilFilterDPLow>T:BA1ODL</OilFilterDPLow>
          <OilTempHigh>T:BA1OTH</OilTempHigh>
          <LoadersRespnSts>T:BA1SNR</LoadersRespnSts>
          <ShaftSensorSts>T:BA1SSC</ShaftSensorSts>
          <MotorPower>T:BA1POWER</MotorPower>
          <MotorVoltage>T:BA1VOLTS</MotorVoltage>
          <MotorCurrent>T:BA1AMPS</MotorCurrent>
          <PowerFactor>T:BA1PF</PowerFactor>
