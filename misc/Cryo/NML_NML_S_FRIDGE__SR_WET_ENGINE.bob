    <actions>
      <action type = "open_display">
        <file>NML_NML_LOOPS__ENGINE_CONTROLS.bob</file>
        <target>window</target>
        <description>Open Display</description>
        <macros>
          <Title>SOUTH_HX_WET_ENGINE</Title>
          <DevName>SPWE</DevName>
          <LoopAutoMan>N:SWEAM</LoopAutoMan>
          <InputDevice>N:SLLDEW</InputDevice>
          <LoopSetPoint>N:SWESP</LoopSetPoint>
          <DevSetManual>N:SWESET</DevSetManual>
          <DevCurrentValue>N:SSPWE</DevCurrentValue>
          <LoopSetMin>N:SWEMIN</LoopSetMin>
          <LoopSetMax>N:SWEMAX</LoopSetMax>
          <EngineOn>N:SWEON</EngineOn>
          <EngineLoc>N:SWEREM</EngineLoc>
          <EngineRdy>N:SWERDY</EngineRdy>
          <EngineReset>N:SWERST</EngineReset>
        </macros>
      </action>
    </actions>
