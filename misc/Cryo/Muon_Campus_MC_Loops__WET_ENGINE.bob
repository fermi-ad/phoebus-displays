  <widget type = "action_button" version = "2.0.0">
    <name>action_button_2462</name>
    <x>245</x>
    <y>454</y>
    <width>100</width>
    <height>20</height>
    <text>Loop\nControls</text>
    <border_width>3.0</border_width>
    <background_color>
        <color name = "darkblue" red = "0" green = "0" blue = "139">
        </color>
    </background_color>
    <foreground_color>
        <color name = "white" red = "255" green = "255" blue = "255">
        </color>
    </foreground_color>
    <font>
        <font family = "Liberation Sans" style = "BOLD" size = "12">
        </font>
    </font>
    <actions>
      <action type = "open_display">
        <file>Muon_Campus_MC_Loops__ENGINE_CONTROLS.bob</file>
        <target>window</target>
        <description>Open Display</description>
        <macros>
          <LoopTitle>$(PTLoopTitle</LoopTitle>
          <LoopAutoMan>$(PTLoopAutoMan</LoopAutoMan>
          <LoopInputDevice>$(PTLoopInputDevice</LoopInputDevice>
          <LoopOutputDevice>$(PTLoopOutputDevice</LoopOutputDevice>
          <LoopDevName>$(PTLoopDevName</LoopDevName>
          <LoopEngineOn>$(PTLoopEngineOn</LoopEngineOn>
          <LoopEngineLoc>$(PTLoopEngineLoc</LoopEngineLoc>
          <LoopEngineRdy>$(PTLoopEngineRdy</LoopEngineRdy>
          <LoopDevCurrentValue>$(PTLoopDevCurrentValue</LoopDevCurrentValue>
          <LoopSetMin>$(PTLoopSetMin</LoopSetMin>
          <LoopSetMax>$(PTLoopSetMax</LoopSetMax>
          <LoopDevSetManual>$(PTLoopSetManual</LoopDevSetManual>
          <LoopSetPoint>$(PTLoopSetPoint)</LoopSetPoint>
        </macros>
      </action>
    </actions>
  </widget>
</display>
