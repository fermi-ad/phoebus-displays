        <macros>
          <Title>SOUTH_HX_DRY_ENGINE</Title>
          <DevName>SPDE</DevName>
          <LoopAutoMan>N:SDEAM</LoopAutoMan>
          <InputDevice>N:STDDEI</InputDevice>
          <LoopSetPoint>N:SDESP</LoopSetPoint>
          <DevSetManual>N:SDESET</DevSetManual>
          <DevCurrentValue>N:SSPDE</DevCurrentValue>
          <LoopSetMin>N:SDEMIN</LoopSetMin>
          <LoopSetMax>N:SDEMAX</LoopSetMax>
          <EngineOn>N:SDEON</EngineOn>
          <EngineLoc>N:SDEREM</EngineLoc>
          <EngineRdy>N:SDERDY</EngineRdy>
          <EngineReset>N:SDERST</EngineReset>
        </macros>
