    </foreground_color>
    <font>
        <font family = "Liberation Sans" style = "BOLD" size = "16">
        </font>
    </font>
    <actions>
      <action type = "open_display">
        <file>CHL_MainMenu.bob</file>
        <target>window</target>
        <description>Open Display</description>
      </action>
    </actions>
  </widget>
</display>
