    <actions>
      <action type = "open_display">
        <file>NML_NML_LOOPS__ENGINE_CONTROLS.bob</file>
        <target>window</target>
        <description>Open Display</description>
        <macros>
          <Title>NORTH_HX_WET_ENGINE</Title>
          <DevName>SPWE</DevName>
          <LoopAutoMan>N:NWEAM</LoopAutoMan>
          <InputDevice>N:NPT13</InputDevice>
          <LoopSetPoint>N:NWESP</LoopSetPoint>
          <DevSetManual>N:NWESET</DevSetManual>
          <DevCurrentValue>N:NSPWE</DevCurrentValue>
          <LoopSetMin>N:NWEMIN</LoopSetMin>
          <LoopSetMax>N:NWEMAX</LoopSetMax>
          <EngineOn>N:NWEON</EngineOn>
          <EngineLoc>N:NWEREM</EngineLoc>
          <EngineRdy>N:NWERDY</EngineRdy>
          <EngineReset>N:NWERST</EngineReset>
        </macros>
      </action>
    </actions>
  </widget>
