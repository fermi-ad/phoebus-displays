        <macros>
          <Title>NORTH_HX_DRY_ENGINE</Title>
          <DevName>SPDE</DevName>
          <LoopAutoMan>N:NDEAM</LoopAutoMan>
          <InputDevice>N:NTDDEI</InputDevice>
          <LoopSetPoint>N:NDESP</LoopSetPoint>
          <DevSetManual>N:NDESET</DevSetManual>
          <DevCurrentValue>N:NSPDE</DevCurrentValue>
          <LoopSetMin>N:NDEMIN</LoopSetMin>
          <LoopSetMax>N:NDEMAX</LoopSetMax>
          <EngineOn>N:NDEON</EngineOn>
          <EngineLoc>N:NDEREM</EngineLoc>
          <EngineRdy>N:NDERDY</EngineRdy>
          <EngineReset>N:NDERST</EngineReset>
