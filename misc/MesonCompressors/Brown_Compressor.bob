  <widget type="action_button" version="3.0.0">
    <name>action_button_1</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>_VALVE_TEMPLATE.bob</file>
        <macros>
          <Title>BROWN+WATER+VALVE+LOOP</Title>
          <DevName>Z:CTVBCW</DevName>
          <LoopAutoMan>Z:CBCWEN</LoopAutoMan>
          <InputDevice>Z:CTBT32</InputDevice>
          <LoopSetPoint>Z:CBCWSP</LoopSetPoint>
          <DevSetManual>Z:CBCWSM</DevSetManual>
          <DevCurrentValue>Z:CTVBCW</DevCurrentValue>
          <LoopSetMin>Z:CBCWMN</LoopSetMin>
          <LoopSetMax>Z:CBCWMX</LoopSetMax>
          <RemLocLoopStatus>Z:CBCWRM</RemLocLoopStatus>
          <StrokeColor>saddlebrown</StrokeColor>
        </macros>
        <target>window</target>
      </action>
    </actions>
    <text>Loop</text>
    <x>610</x>
    <y>400</y>
    <width>45</width>
    <height>50</height>
    <font>
