    <vertical_alignment>1</vertical_alignment>
    <border_width>2</border_width>
  </widget>
  <widget type="stripchart" version="2.1.0">
    <name>Strip Chart_2</name>
    <x>20</x>
    <y>420</y>
    <width>1230</width>
    <height>333</height>
    <background_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
    <show_grid>true</show_grid>
    <title>Flow &amp; Pressure</title>
    <scale_font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </scale_font>
    <show_legend>true</show_legend>
    <rules>
      <rule name="Show He Flow - high - trace" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>loc://He1</pv_name>
      </rule>
      <rule name="Show He Flow - low - trace" prop_id="traces[1].visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>loc://He2</pv_name>
      </rule>
      <rule name="Show GHe 40K Supply pressure" prop_id="traces[2].visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>loc://He3</pv_name>
      </rule>
      <rule name="Show Warm He Supply pressure" prop_id="traces[3].visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>loc://He4</pv_name>
      </rule>
      <rule name="Show 80K Return pressure" prop_id="traces[4].visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>loc://He5</pv_name>
      </rule>
      <rule name="Show Suction Return pressure" prop_id="traces[5].visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>loc://He6</pv_name>
      </rule>
    </rules>
    <start>-12 hour</start>
    <end>now</end>
    <y_axes>
      <y_axis>
        <title>He Flow (g/s)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>-5.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>true</show_grid>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
      <y_axis>
        <title>GHe Pressure (psig)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>250.0</maximum>
        <show_grid>true</show_grid>
        <visible>true</visible>
        <color>
          <color name="HWRcolor" red="0" green="181" blue="226">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>FT600A - high</name>
        <y_pv>$(system)FT600A:GHeFlow</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="255" blue="255">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>false</visible>
      </trace>
      <trace>
        <name>FT600B - low</name>
        <y_pv>$(system)FT600B:GHeFlow</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color name="Attention" red="255" green="160" blue="0">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>false</visible>
      </trace>
      <trace>
        <name>40K Supply - PT612</name>
        <y_pv>$(system)PT612:Pressure</y_pv>
        <axis>1</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>false</visible>
      </trace>
      <trace>
        <name>Warm He Supply - PT711H</name>
        <y_pv>$(system)PT711:Pressure</y_pv>
        <axis>1</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="255" green="0" blue="0">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>false</visible>
      </trace>
      <trace>
        <name>80K Return - PT613</name>
        <y_pv>$(system)PT613:Pressure</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="255" blue="0">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>false</visible>
      </trace>
      <trace>
        <name>Suction Return - 1PTLSL</name>
        <y_pv>$(system)1PTLSL:Pressure</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="170" green="0" blue="255">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>false</visible>
      </trace>
    </traces>
  </widget>
