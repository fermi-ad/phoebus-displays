<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <width>1500</width>
  <height>1500</height>
  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot</name>
    <x>168</x>
    <y>70</y>
    <width>1310</width>
    <height>550</height>
    <foreground_color>
      <color name="HWRcolor" red="0" green="181" blue="226">
      </color>
    </foreground_color>
    <background_color>
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </background_color>
    <title>DCCT RAW Currnt (mA)</title>
    <title_font>
      <font family="Liberation Sans" style="BOLD" size="25.0">
      </font>
    </title_font>
    <x_axis>
      <title>Sample Count</title>
      <autoscale>false</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>2050.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font family="Liberation Sans" style="BOLD" size="20.0">
        </font>
      </title_font>
      <scale_font>
        <font family="Liberation Sans" style="REGULAR" size="20.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>DCCT Raw Current (mA)</title>
        <autoscale>false</autoscale>
        <log_scale>false</log_scale>
        <minimum>-1.0</minimum>
        <maximum>1.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font family="Liberation Sans" style="BOLD" size="20.0">
          </font>
        </title_font>
        <scale_font>
          <font family="Liberation Sans" style="REGULAR" size="20.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="HWRcolor" red="0" green="181" blue="226">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>DCCT-Raw-Current</name>
        <x_pv></x_pv>
        <y_pv>A0TST:IS_BI_DCCT_Raw:mA.AVAL</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color name="On" red="0" green="255" blue="0">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>DCCT-Raw-Current(BL-Corrected)</name>
        <x_pv></x_pv>
        <y_pv>A0TST:IS_BI_DCCT_Raw:mA_new_corrected.AVAL</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color name="Write_Background" red="128" green="255" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
