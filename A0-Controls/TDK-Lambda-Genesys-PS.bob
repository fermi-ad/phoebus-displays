  <widget type="group" version="3.0.0">
    <name>PS-Controls</name>
    <y>59</y>
    <width>310</width>
    <height>410</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="18.0">
      </font>
    </font>
    <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <actions>
        <action type="write_pv">
          <description>PS ON</description>
          <pv_name>A0:TDKLambdaGen:POWER:SP</pv_name>
          <value>1</value>
        </action>
      </actions>
      <x>1</x>
      <y>7</y>
      <width>116</width>
      <height>41</height>
      <rules>
        <rule name="button_color" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0 == 1">
            <value>
              <color name="On" red="0" green="255" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="pv0 == 0">
            <value>
              <color name="STOP" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>A0:TDKLambdaGen:POWER:SP</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_1</name>
      <actions>
        <action type="write_pv">
          <description>PS OFF</description>
          <pv_name>A0:TDKLambdaGen:POWER:SP</pv_name>
          <value>0</value>
        </action>
      </actions>
      <x>147</x>
      <y>7</y>
      <width>116</width>
      <height>41</height>
      <rules>
        <rule name="button_color" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0 == 0">
            <value>
              <color name="On" red="0" green="255" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="pv0 == 1">
            <value>
              <color name="STOP" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>A0:TDKLambdaGen:POWER:SP</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
    </widget>
