  <widget type="tabs" version="2.0.0">
    <name>Tabs</name>
    <tabs>
      <tab>
        <name>Waveforms</name>
        <children>
          <widget type="xyplot" version="3.0.0">
            <name>X/Y Plot</name>
            <x>8</x>
            <y>2</y>
            <width>430</width>
            <height>160</height>
            <background_color>
              <color red="204" green="204" blue="204">
              </color>
            </background_color>
            <title>RF Pickup Magnitude</title>
            <y_axes>
              <y_axis>
                <title>RF Magnitude</title>
                <autoscale>true</autoscale>
                <log_scale>false</log_scale>
                <minimum>0.0</minimum>
                <maximum>100.0</maximum>
                <show_grid>false</show_grid>
                <title_font>
                  <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
                  </font>
                </title_font>
                <scale_font>
                  <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
                  </font>
                </scale_font>
                <on_right>false</on_right>
                <visible>true</visible>
                <color>
                  <color name="Text" red="0" green="0" blue="0">
                  </color>
                </color>
              </y_axis>
            </y_axes>
            <traces>
              <trace>
                <name>RF Amplitude</name>
                <x_pv></x_pv>
                <y_pv>$(dev)MagWfm</y_pv>
                <err_pv></err_pv>
                <axis>0</axis>
                <trace_type>1</trace_type>
                <color>
                  <color red="255" green="0" blue="0">
                  </color>
                </color>
                <line_width>1</line_width>
                <line_style>0</line_style>
                <point_type>0</point_type>
                <point_size>10</point_size>
                <visible>true</visible>
              </trace>
            </traces>
          </widget>
          <widget type="xyplot" version="3.0.0">
            <name>X/Y Plot_1</name>
            <x>8</x>
            <y>182</y>
            <width>430</width>
            <height>160</height>
            <background_color>
              <color red="204" green="204" blue="204">
              </color>
            </background_color>
            <title>RF Pickup Phase</title>
            <y_axes>
              <y_axis>
                <title>RF Phase</title>
                <autoscale>true</autoscale>
                <log_scale>false</log_scale>
                <minimum>0.0</minimum>
                <maximum>100.0</maximum>
                <show_grid>false</show_grid>
                <title_font>
                  <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
                  </font>
                </title_font>
                <scale_font>
                  <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
                  </font>
                </scale_font>
                <on_right>false</on_right>
                <visible>true</visible>
                <color>
                  <color name="Text" red="0" green="0" blue="0">
                  </color>
                </color>
              </y_axis>
            </y_axes>
            <traces>
              <trace>
                <name>RF Phase</name>
                <x_pv></x_pv>
                <y_pv>$(dev)PhaseWfm</y_pv>
                <err_pv></err_pv>
                <axis>0</axis>
                <trace_type>1</trace_type>
                <color>
                  <color red="255" green="0" blue="0">
                  </color>
                </color>
                <line_width>1</line_width>
                <line_style>0</line_style>
                <point_type>0</point_type>
                <point_size>10</point_size>
                <visible>true</visible>
              </trace>
            </traces>
          </widget>
        </children>
