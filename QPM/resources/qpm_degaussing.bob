<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>qpm_degaussing</name>
  <width>500</width>
  <height>150</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <macros>
      <DESC>QPC$(NUM) Degauss Max Current:</DESC>
      <RB_PV>$(DEVICE):QPC$(NUM)_Degauss_IMax_RB</RB_PV>
      <SP_PV>$(DEVICE):QPC$(NUM)_Degauss_IMax_SP</SP_PV>
    </macros>
    <file>../widget-library/readback&amp;setpoint.bob</file>
    <y>29</y>
    <width>500</width>
    <height>30</height>
    <resize>2</resize>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_1</name>
    <macros>
      <DESC>QPC$(NUM) Degauss T damping:</DESC>
      <RB_PV>$(DEVICE):QPC$(NUM)_Degauss_TDamp_RB</RB_PV>
      <SP_PV>$(DEVICE):QPC$(NUM)_Degauss_TDamp_SP</SP_PV>
    </macros>
    <file>../widget-library/readback&amp;setpoint.bob</file>
    <y>59</y>
    <width>500</width>
    <height>30</height>
    <resize>2</resize>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_2</name>
    <macros>
      <DESC>QPC$(NUM) Degauss T period:</DESC>
      <RB_PV>$(DEVICE):QPC$(NUM)_Degauss_TPeriod_RB</RB_PV>
      <SP_PV>$(DEVICE):QPC$(NUM)_Degauss_TPeriod_SP</SP_PV>
    </macros>
    <file>../widget-library/readback&amp;setpoint.bob</file>
    <y>89</y>
    <width>500</width>
    <height>30</height>
    <resize>2</resize>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_BarHeavy</class>
    <y>17</y>
    <width>500</width>
    <height use_class="true">3</height>
    <line_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </line_color>
    <background_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Title</class>
    <text>Degaussing</text>
    <x>201</x>
    <y>5</y>
    <width>98</width>
    <height>27</height>
    <font use_class="true">
      <font name="EDE Header" family="sans" style="BOLD" size="18.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
      </color>
    </background_color>
    <transparent>false</transparent>
    <auto_size>true</auto_size>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_10</name>
    <macros>
      <DESC>QPC$(NUM) Degauss mode on/off:</DESC>
      <PV>$(DEVICE):QPC$(NUM)_DegaussStatus_B0_RB</PV>
    </macros>
    <file>../widget-library/status_error-ok.bob</file>
    <y>119</y>
    <height>30</height>
    <resize>2</resize>
  </widget>
</display>
