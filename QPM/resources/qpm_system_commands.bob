<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>qpm_system_control</name>
  <width>500</width>
  <height>105</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <class>EDE_Label</class>
    <text>System commands:</text>
    <x>10</x>
    <y>70</y>
    <width>180</width>
    <height>30</height>
    <font use_class="true">
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>Text Entry</name>
    <class>EDE_Spinner</class>
    <pv_name>$(DEVICE):SystemControl_SP</pv_name>
    <x>300</x>
    <y>74</y>
    <width>190</width>
    <height>22</height>
    <font>
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="EDE BackgroundSetpoint" red="250" green="250" blue="250">
      </color>
    </background_color>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <macros>
      <DESC>Bulk power supply voltage:</DESC>
      <RB_PV>$(DEVICE):BulkPsV_RB</RB_PV>
      <SP_PV>$(DEVICE):BulkPsV_SP</SP_PV>
    </macros>
    <file>../widget-library/readback&amp;setpoint.bob</file>
    <y>40</y>
    <width>500</width>
    <height>30</height>
    <resize>2</resize>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_BarHeavy</class>
    <y>16</y>
    <width>500</width>
    <height use_class="true">3</height>
    <line_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </line_color>
    <background_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Title</class>
    <text>System control</text>
    <x>187</x>
    <y>5</y>
    <width>127</width>
    <height>24</height>
    <font use_class="true">
      <font name="EDE Header" family="sans" style="BOLD" size="18.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
      </color>
    </background_color>
    <transparent>false</transparent>
    <auto_size>true</auto_size>
  </widget>
</display>
