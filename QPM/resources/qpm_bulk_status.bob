<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>qpm_bulk_status</name>
  <width>400</width>
  <height>260</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_BarHeavy</class>
    <y>16</y>
    <width>400</width>
    <height use_class="true">3</height>
    <line_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </line_color>
    <background_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Title</class>
    <text>Bulk Status</text>
    <x>152</x>
    <y>5</y>
    <width>96</width>
    <height>24</height>
    <font use_class="true">
      <font name="EDE Header" family="sans" style="BOLD" size="18.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
      </color>
    </background_color>
    <transparent>false</transparent>
    <auto_size>true</auto_size>
  </widget>
  <widget type="group" version="2.0.0">
    <name>Group</name>
    <y>35</y>
    <width>400</width>
    <height>210</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_20</name>
      <macros>
        <DESC>Bulk PS Remote/Local:</DESC>
        <PV>$(DEVICE):System_Status_B15_RB</PV>
      </macros>
      <file>../widget-library/status_warning-ok.bob</file>
      <y>180</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_19</name>
      <macros>
        <DESC>Bulk PS On/Off Request:</DESC>
        <PV>$(DEVICE):System_Status_B14_RB</PV>
      </macros>
      <file>../widget-library/status_warning-ok.bob</file>
      <y>150</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_18</name>
      <macros>
        <DESC>Bulk PS On/Off Status:</DESC>
        <PV>$(DEVICE):System_Status_B13_RB</PV>
      </macros>
      <file>../widget-library/status_warning-ok.bob</file>
      <y>120</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_17</name>
      <macros>
        <DESC>Bulk PS Constant Current:</DESC>
        <PV>$(DEVICE):System_Status_B12_RB</PV>
      </macros>
      <file>../widget-library/status_warning-ok.bob</file>
      <y>90</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_16</name>
      <macros>
        <DESC>Bulk CAP Over V:</DESC>
        <PV>$(DEVICE):System_Status_B11_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>60</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_15</name>
      <macros>
        <DESC>Bulk CAP Over I:</DESC>
        <PV>$(DEVICE):System_Status_B10_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>30</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_14</name>
      <macros>
        <DESC>Bulk Crowbar Relay:</DESC>
        <PV>$(DEVICE):System_Status_B0_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <height>30</height>
      <resize>2</resize>
    </widget>
  </widget>
</display>
