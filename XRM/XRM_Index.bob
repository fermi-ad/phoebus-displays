<display version="2.0.0">
  <name>XRM Index</name>
  <background_color>
    <color red="204" green="255" blue="255">
    </color>
  </background_color>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>acq2106_347</description>
        <file>acq400_launcher.bob</file>
        <macros>
          <UUT>acq2106_347</UUT>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <x>40</x>
    <y>90</y>
    <width>170</width>
    <foreground_color>
      <color name="LB650color" red="0" green="76" blue="151">
      </color>
    </foreground_color>
    <background_color>
      <color red="255" green="255" blue="102">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>XRM Index Page ‒ eXtensible Rack Monitor</text>
    <x>40</x>
    <y>30</y>
    <width>580</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="24.0">
      </font>
    </font>
    <foreground_color>
      <color name="LB650color" red="0" green="76" blue="151">
      </color>
    </foreground_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <text>xFer Gallery Controls ACQ423EL-32-200-16 x 2</text>
    <x>230</x>
    <y>90</y>
    <width>370</width>
    <height>30</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="16.0">
      </font>
    </font>
    <foreground_color>
      <color name="LB650color" red="0" green="76" blue="151">
      </color>
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
  </widget>
</display>
