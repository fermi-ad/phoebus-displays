<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>PRMT_$(UUT)</name>
  <width>750</width>
  <height>740</height>
  <widget type="group" version="3.0.0">
    <name>SYSTEM</name>
    <y>10</y>
    <width>880</width>
    <height>910</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>TITLE_1</name>
      <text>PRMT $(UUT)</text>
      <width>330</width>
      <height>50</height>
      <font>
        <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="group" version="3.0.0">
      <name>Control</name>
      <x>600</x>
      <y>70</y>
      <width>250</width>
      <height>120</height>
      <widget type="bool_button" version="2.0.0">
        <name>RUN_BUTTON</name>
        <pv_name>${UUT}:PRMT:RUNSTOP</pv_name>
        <x>3</x>
        <y>12</y>
        <height>50</height>
        <off_label>RUN</off_label>
        <on_label>STOP</on_label>
        <actions>
          <action type="write_pv">
            <description>Write PV</description>
            <pv_name>$(pv_name)</pv_name>
            <value>1</value>
          </action>
          <action type="write_pv">
            <description>Write PV</description>
            <pv_name>$(pv_name)</pv_name>
            <value>0</value>
          </action>
        </actions>
      </widget>
      <widget type="textupdate" version="2.0.0">
        <name>Text Update</name>
        <pv_name>${UUT}:PRMT:UPDATES</pv_name>
        <x>3</x>
        <y>72</y>
        <width>111</width>
      </widget>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>Combo Box</name>
      <pv_name>${UUT}:SOE:MON_RL</pv_name>
      <x>230</x>
      <y>10</y>
      <width>110</width>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Status1</name>
      <macros>
        <SITE>1</SITE>
      </macros>
      <file>prm_site_status.bob</file>
      <x>10</x>
      <y>210</y>
      <width>740</width>
      <height>90</height>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Status1_1</name>
      <macros>
        <SITE>5</SITE>
      </macros>
      <file>prm_site_status.bob</file>
      <y>480</y>
      <width>750</width>
      <height>90</height>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Status1_2</name>
      <macros>
        <SITE>6</SITE>
      </macros>
      <file>prm_site_status.bob</file>
      <y>560</y>
      <width>750</width>
      <height>90</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_2</name>
      <pv_name>${UUT}:PRMT:LUT:LAST_EVENT</pv_name>
      <x>231</x>
      <y>90</y>
      <width>130</width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_2</name>
      <pv_name>${UUT}:PRMT:LUT:SOFT_EVENT</pv_name>
      <x>231</x>
      <y>130</y>
      <width>120</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_8</name>
      <text>LAST EVENT</text>
      <x>100</x>
      <y>90</y>
      <width>110</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_9</name>
      <text>SOFT_EVENT</text>
      <x>100</x>
      <y>130</y>
    </widget>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_1</name>
    <x>250</x>
    <y>990</y>
    <width>10</width>
    <height>1</height>
  </widget>
</display>
