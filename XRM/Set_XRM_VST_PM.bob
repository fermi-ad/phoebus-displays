        <file>Set_XRM_VST_PM-Chnl.bob</file>
        <macros>
          <PM>00</PM>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <x>25</x>
    <y>122</y>
    <width>350</width>
    <height>50</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="20.0">
      </font>
    </font>
