<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>A0TST Main</name>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>A0 IS Landing Page</text>
    <width>220</width>
    <height>40</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_HV.bob</description>
        <file>A0TST/A0TST_HV.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Source HV</text>
    <x>100</x>
    <y>850</y>
    <width>150</width>
    <height>90</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_LCW.bob</description>
        <file>A0TST/A0TST_LCW.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Source Water</text>
    <x>370</x>
    <y>850</y>
    <width>150</width>
    <height>90</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_VAC.bob</description>
        <file>A0TST/A0TST_VAC.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Source Vacuum</text>
    <x>630</x>
    <y>850</y>
    <width>150</width>
    <height>90</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="open_display">
        <description>Open P.Hanlet ISmain.bob</description>
        <file>../WFE/ISmain.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>A0 Test Stand Monitoring</text>
    <x>890</x>
    <y>850</y>
    <width>150</width>
    <height>90</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="picture" version="2.0.0">
