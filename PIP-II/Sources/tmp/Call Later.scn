<commands>
  <comment>
    <text>Test of a file to be called from another file</text>
  </comment>
  <delay>
    <seconds>1.0</seconds>
  </delay>
  <if>
    <device>device</device>
    <value>5.0</value>
    <comparison>EQUALS</comparison>
    <tolerance>0.1</tolerance>
    <body>
      <delay>
        <seconds>2.0</seconds>
      </delay>
      <set>
        <device>device</device>
        <value>6.0</value>
        <wait>false</wait>
        <tolerance>0.1</tolerance>
      </set>
    </body>
  </if>
</commands>
