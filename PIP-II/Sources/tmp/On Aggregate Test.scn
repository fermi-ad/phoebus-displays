<commands>
  <comment>
    <text>GAS FLOW(previously ACL script)</text>
  </comment>
  <comment>
    <text>Device 1 set to specific value</text>
  </comment>
  <set>
    <device>DEVICE 1</device>
    <value>"VALUE"</value>
    <readback>device</readback>
    <tolerance>0.1</tolerance>
  </set>
  <delay>
    <seconds>3.0</seconds>
  </delay>
  <wait>
    <device>device</device>
    <value>0.0</value>
    <comparison>EQUALS</comparison>
    <tolerance>0.1</tolerance>
  </wait>
  <comment>
    <text>Device 2 set to specific value</text>
  </comment>
  <set>
    <device>DEVICE 2</device>
    <value>"VALUE"</value>
    <readback>device</readback>
    <tolerance>0.1</tolerance>
  </set>
  <wait>
    <device>device</device>
    <value>0.0</value>
    <comparison>EQUALS</comparison>
    <tolerance>0.1</tolerance>
  </wait>
  <delay>
    <seconds>3.0</seconds>
  </delay>
  <comment>
    <text>Device 3 set to specific value</text>
  </comment>
  <set>
    <device>DEVICE 3</device>
    <value>"VALUE"</value>
    <readback>device</readback>
    <tolerance>0.1</tolerance>
  </set>
  <wait>
    <device>device</device>
    <value>0.0</value>
    <comparison>EQUALS</comparison>
    <tolerance>0.1</tolerance>
  </wait>
  <delay>
    <seconds>3.0</seconds>
  </delay>
  <comment>
    <text>There will be multiple groups of setting a device to a value, then delay.</text>
  </comment>
  <set>
    <device>ARC VOLTAGE</device>
    <value>125.0</value>
    <readback>ARC VOLTAGE</readback>
    <readback_value>125.0</readback_value>
    <tolerance>0.1</tolerance>
  </set>
  <comment>
    <text>TURN ON(previously ACL script)</text>
  </comment>
  <sequence>
    <body>
      <comment>
        <text>Initial ramp of Filament Current</text>
      </comment>
      <loop>
        <device>FILAMENT CURRENT</device>
        <start>0.0</start>
        <end>200.0</end>
        <step>10.0</step>
        <tolerance>1.0</tolerance>
        <body>
          <delay>
            <seconds>0.25</seconds>
          </delay>
        </body>
      </loop>
      <comment>
        <text>This sequence will keep ARC VOLTAGE at 120V during the turn on process while FILAMENT CURRENT is ramped up.</text>
      </comment>
      <parallel>
        <body>
          <if>
            <device>ARC VOLTAGE</device>
            <value>120.0</value>
            <comparison>AT_LEAST</comparison>
            <tolerance>0.5</tolerance>
            <body>
              <if>
                <device>FILAMENT CURRENT</device>
                <value>200.0</value>
                <comparison>BELOW</comparison>
                <tolerance>0.1</tolerance>
                <body>
                  <comment>
                    <text>Need general INCREASE command that does not require inputting the initial value.</text>
                  </comment>
                </body>
              </if>
              <comment>
                <text>This is a comment</text>
              </comment>
              <if>
                <device>FILAMENT CURRENT</device>
                <value>200.0</value>
                <comparison>AT_LEAST</comparison>
                <tolerance>0.1</tolerance>
                <body>
                  <loop>
                    <device>FILAMENT CURRENT</device>
                    <start>200.0</start>
                    <end>300.0</end>
                    <step>0.5</step>
                    <tolerance>0.05</tolerance>
                    <body>
                      <delay>
                        <seconds>2.0</seconds>
                      </delay>
                      <wait>
                        <device>ARC VOLTAGE</device>
                        <value>120.0</value>
                        <comparison>AT_MOST</comparison>
                        <tolerance>0.5</tolerance>
                      </wait>
                    </body>
                  </loop>
                </body>
              </if>
            </body>
          </if>
          <if>
            <device>ARC VOLTAGE</device>
            <value>120.0</value>
            <comparison>AT_MOST</comparison>
            <tolerance>0.1</tolerance>
            <body>
              <loop>
                <device>FILAMENT CURRENT</device>
                <start>0.0</start>
                <end>10.0</end>
                <step>1.0</step>
                <tolerance>0.1</tolerance>
                <body/>
              </loop>
            </body>
          </if>
        </body>
      </parallel>
    </body>
  </sequence>
</commands>
