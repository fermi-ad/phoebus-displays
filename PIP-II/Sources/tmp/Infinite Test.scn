<commands>
  <set>
    <device>pva://evan:test0</device>
    <value>0.0</value>
    <wait>false</wait>
    <tolerance>0.1</tolerance>
  </set>
  <set>
    <device>pva://evan:test1</device>
    <value>0.0</value>
    <wait>false</wait>
    <tolerance>0.1</tolerance>
  </set>
  <while>
    <device>pva://evan:test1</device>
    <value>10.0</value>
    <comparison>BELOW</comparison>
    <tolerance>0.1</tolerance>
    <tolerance>0.1</tolerance>
    <body>
      <script>
        <path>Increment</path>
        <arguments>
          <argument>pva://evan:test0</argument>
          <argument>1</argument>
        </arguments>
      </script>
      <delay>
        <seconds>0.5</seconds>
      </delay>
      <script>
        <path>Increment</path>
        <arguments>
          <argument>pva://evan:test0</argument>
          <argument>-1</argument>
        </arguments>
      </script>
      <delay>
        <seconds>0.5</seconds>
      </delay>
    </body>
  </while>
</commands>
