<commands>
  <comment>
    <text>This script lets you increase device A(test0) only while conditions on device B(test1) are met. The Parallel loop is used to replicate 2device B chaging on its own. </text>
  </comment>
  <delay>
    <seconds>2.0</seconds>
  </delay>
  <parallel>
    <body>
      <loop>
        <device>pva://evan:test1</device>
        <start>0.0</start>
        <end>20.0</end>
        <step>0.5</step>
        <readback>pva://evan:test1</readback>
        <tolerance>0.05</tolerance>
        <body>
          <delay>
            <seconds>0.5</seconds>
          </delay>
        </body>
      </loop>
      <loop>
        <device>pva://evan:test0</device>
        <start>0.0</start>
        <end>10.0</end>
        <step>0.5</step>
        <tolerance>0.05</tolerance>
        <body>
          <delay>
            <seconds>0.5</seconds>
          </delay>
          <wait>
            <device>pva://evan:test0</device>
            <value>10.0</value>
            <comparison>AT_MOST</comparison>
            <tolerance>0.1</tolerance>
          </wait>
        </body>
      </loop>
    </body>
  </parallel>
  <comment>
    <text>I hope this worked!</text>
  </comment>
  <delay>
    <seconds>2.0</seconds>
  </delay>
</commands>
