<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <width>1100</width>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <width>1100</width>
    <height>90</height>
    <line_width>2</line_width>
    <line_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </line_color>
    <background_color>
      <color red="0" green="40" blue="85">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Title Text</name>
    <text>Cusp Ion Source (Test Stand)</text>
    <x>200</x>
    <width>700</width>
    <height>90</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_HV.bob</description>
        <file>A0TST/A0TST_HV.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Supplies</text>
    <x>90</x>
    <y>120</y>
    <width>70</width>
    <height>24</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_LCW.bob</description>
        <file>A0TST/A0TST_LCW.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>LCW</text>
    <x>250</x>
    <y>120</y>
    <width>70</width>
    <height>24</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_VAC.bob</description>
        <file>A0TST/A0TST_VAC.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>VAC</text>
    <x>170</x>
    <y>120</y>
    <width>70</width>
    <height>24</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="open_display">
        <description>Open P.Hanlet ISmain.bob</description>
        <file>../WFE/ISmain.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Status</text>
    <x>10</x>
    <y>120</y>
    <width>70</width>
    <height>24</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="text-symbol" version="2.0.0">
    <name>Text Symbol</name>
    <x>790</x>
    <y>170</y>
    <width>1</width>
    <height>1</height>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_1</name>
    <y>90</y>
    <width>1100</width>
    <height>24</height>
    <line_width>2</line_width>
    <line_color>
      <color red="255" green="255" blue="255">
      </color>
    </line_color>
    <background_color>
      <color red="65" green="182" blue="230" alpha="137">
      </color>
    </background_color>
  </widget>
</display>
