<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <macros>
    <acc>A0TST</acc>
    <sys>IS</sys>
    <group>BLE</group>
  </macros>
  <width>1100</width>
  <background_color>
    <color name="Read_Background" red="240" green="240" blue="240">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <width>1100</width>
    <height>90</height>
    <line_width>2</line_width>
    <line_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </line_color>
    <background_color>
      <color red="0" green="40" blue="85">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Title Text</name>
    <text>Cusp Ion Source (Test Stand)</text>
    <x>200</x>
    <width>700</width>
    <height>90</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_HV.bob</description>
        <file>A0TST/A0TST_HV.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Supplies</text>
    <x>90</x>
    <y>120</y>
    <width>70</width>
    <height>20</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_LCW.bob</description>
        <file>A0TST/A0TST_LCW.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>LCW</text>
    <x>250</x>
    <y>120</y>
    <width>70</width>
    <height>20</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="open_display">
        <description>Open A0TST_VAC.bob</description>
        <file>A0TST/A0TST_VAC.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>VAC</text>
    <x>170</x>
    <y>120</y>
    <width>70</width>
    <height>20</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="open_display">
        <description>Open P.Hanlet ISmain.bob</description>
        <file>../WFE/ISmain.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Status</text>
    <x>10</x>
    <y>120</y>
    <width>70</width>
    <height>20</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="text-symbol" version="2.0.0">
    <name>Text Symbol</name>
    <x>790</x>
    <y>170</y>
    <width>1</width>
    <height>1</height>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_1</name>
    <y>90</y>
    <width>1100</width>
    <height>24</height>
    <line_width>2</line_width>
    <line_color>
      <color red="255" green="255" blue="255">
      </color>
    </line_color>
    <background_color>
      <color red="65" green="182" blue="230" alpha="137">
      </color>
    </background_color>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Supplies</name>
    <x>20</x>
    <y>390</y>
    <width>678</width>
    <height>188</height>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display</name>
      <macros>
        <dev>FLMNT</dev>
        <read>Current</read>
        <read2>Voltage</read2>
      </macros>
      <file>_PS_Row.bob</file>
      <x>20</x>
      <y>10</y>
      <width>605</width>
      <height>21</height>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_1</name>
      <macros>
        <dev>ARC</dev>
        <read>Voltage</read>
        <read2>Current</read2>
      </macros>
      <file>_PS_Row.bob</file>
      <x>20</x>
      <y>37</y>
      <width>605</width>
      <height>21</height>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_2</name>
      <macros>
        <dev>PLASMA</dev>
        <read>Voltage</read>
        <read2>Current</read2>
      </macros>
      <file>_PS_Row.bob</file>
      <x>20</x>
      <y>64</y>
      <width>605</width>
      <height>21</height>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_3</name>
      <macros>
        <dev>EXTRCT</dev>
        <read>Voltage</read>
        <read2>Current</read2>
      </macros>
      <file>_PS_Row.bob</file>
      <x>20</x>
      <y>91</y>
      <width>605</width>
      <height>21</height>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_4</name>
      <macros>
        <dev>BIAS</dev>
        <read>Voltage</read>
        <read2>Current</read2>
      </macros>
      <file>_PS_Row.bob</file>
      <x>20</x>
      <y>118</y>
      <width>605</width>
      <height>21</height>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Area Secure</name>
    <x>940</x>
    <y>114</y>
    <width>156</width>
    <height>116</height>
    <widget type="label" version="2.0.0">
      <name>Label_1</name>
      <text>HV Rack</text>
      <x>30</x>
      <width>90</width>
    </widget>
    <widget type="multi_state_led" version="2.0.0">
      <name>LED (Multi State)</name>
      <width>19</width>
      <height>19</height>
      <states>
        <state>
          <value>0</value>
          <label>0</label>
          <color>
            <color name="OK" red="0" green="255" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label>1</label>
          <color>
            <color name="MAJOR" red="255" green="0" blue="0">
            </color>
          </color>
        </state>
      </states>
      <fallback_label>!</fallback_label>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_2</name>
      <text>IS Rack</text>
      <x>30</x>
      <y>30</y>
      <width>90</width>
    </widget>
    <widget type="multi_state_led" version="2.0.0">
      <name>LED (Multi State)_1</name>
      <y>30</y>
      <width>19</width>
      <height>19</height>
      <states>
        <state>
          <value>0</value>
          <label>0</label>
          <color>
            <color name="OK" red="0" green="255" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label>1</label>
          <color>
            <color name="MAJOR" red="255" green="0" blue="0">
            </color>
          </color>
        </state>
      </states>
      <fallback_label>!</fallback_label>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_3</name>
      <text>Enclosure</text>
      <x>30</x>
      <y>60</y>
      <width>90</width>
    </widget>
    <widget type="multi_state_led" version="2.0.0">
      <name>LED (Multi State)_2</name>
      <y>60</y>
      <width>19</width>
      <height>19</height>
      <states>
        <state>
          <value>0</value>
          <label>0</label>
          <color>
            <color name="OK" red="0" green="255" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label>1</label>
          <color>
            <color name="MAJOR" red="255" green="0" blue="0">
            </color>
          </color>
        </state>
      </states>
      <fallback_label>!</fallback_label>
    </widget>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_4</name>
    <text>WIP: This display is under construction</text>
    <x>200</x>
    <y>4</y>
    <width>700</width>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="MINOR" red="255" green="128" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="MINOR" red="255" green="128" blue="0">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
  </widget>
</display>
