  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="write_pv">
        <description>Remove Invalidity</description>
        <pv_name>PIP2:CTRL_MPS:acq2106_345:3:IMM:DO:BYTE1.B9</pv_name>
        <value>1</value>
      </action>
    </actions>
    <x>365</x>
    <y>18</y>
    <width>104</width>
    <height>33</height>
    <background_color>
      <color name="INVALID" red="255" green="0" blue="255">
      </color>
    </background_color>
    <rules>
      <rule name="Change_color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 = 1">
          <value>
            <color name="On" red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>PIP2:CTRL_MPS:acq2106_345:3:IMM:DO:BYTE1.B9</pv_name>
      </rule>
      <rule name="Text" prop_id="text" out_exp="false">
        <exp bool_exp="pv0 = 1">
          <value>Valid</value>
        </exp>
        <pv_name>PIP2:CTRL_MPS:acq2106_345:3:IMM:DO:BYTE1.B9</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
