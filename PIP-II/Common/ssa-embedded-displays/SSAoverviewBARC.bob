<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>BARC - SSA Overview</name>
  <width>145</width>
  <height>355</height>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_11</name>
    <width>145</width>
    <height>305</height>
    <line_width>1</line_width>
    <line_color>
      <color red="0" green="0" blue="0">
      </color>
    </line_color>
    <background_color>
      <color red="179" green="179" blue="179">
      </color>
    </background_color>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button</name>
    <pv_name>$(hprf)SSA$(cav):sOUT</pv_name>
    <y>330</y>
    <width>145</width>
    <height>25</height>
    <off_label>Set On</off_label>
    <on_label>Set Off</on_label>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <show_confirm_dialog>1</show_confirm_dialog>
    <confirm_message>Are your sure you want to set SSA power On/Off?</confirm_message>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_48</name>
    <actions>
      <action type="write_pv">
        <description>Amplifier Reset</description>
        <pv_name>$(hprf)SSA1:sOUT</pv_name>
        <value>4</value>
      </action>
    </actions>
    <pv_name>$(hprf)SSA$(cav):sOUT</pv_name>
    <y>305</y>
    <width>145</width>
    <height>25</height>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_93</name>
    <text>SSA$(ssa)</text>
    <x>5</x>
    <y>5</y>
    <width>132</width>
    <height>25</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
