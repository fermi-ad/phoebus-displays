  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>5</x>
    <y>60</y>
    <width>135</width>
    <height>150</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="group" version="3.0.0">
      <name>Group</name>
      <y>90</y>
      <width>135</width>
      <height>60</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="label" version="2.0.0">
        <name>Label_87</name>
        <text> RF Permit</text>
        <x>20</x>
        <y>40</y>
        <width>115</width>
        <font>
          <font family="Liberation Sans" style="BOLD" size="12.0">
          </font>
        </font>
        <vertical_alignment>1</vertical_alignment>
      </widget>
      <widget type="label" version="2.0.0">
        <name>Label_88</name>
        <text> SSA Ready</text>
        <x>20</x>
        <width>115</width>
        <font>
          <font family="Liberation Sans" style="BOLD" size="12.0">
          </font>
        </font>
        <vertical_alignment>1</vertical_alignment>
      </widget>
      <widget type="label" version="2.0.0">
        <name>Label_90</name>
        <text> DC Permit</text>
        <x>20</x>
        <y>20</y>
        <width>115</width>
        <font>
          <font family="Liberation Sans" style="BOLD" size="12.0">
          </font>
        </font>
        <vertical_alignment>1</vertical_alignment>
      </widget>
      <widget type="byte_monitor" version="2.0.0">
        <name>Byte Monitor_20</name>
        <pv_name>$(P)HPRF_SSA$(cav):Permits</pv_name>
        <width>20</width>
        <height>60</height>
        <numBits>3</numBits>
        <bitReverse>true</bitReverse>
        <horizontal>false</horizontal>
        <square>true</square>
        <on_color>
          <color name="OK" red="0" green="255" blue="0">
          </color>
        </on_color>
        <off_label>0</off_label>
        <on_label>1</on_label>
        <border_alarm_sensitive>false</border_alarm_sensitive>
      </widget>
    </widget>
    <widget type="group" version="3.0.0">
      <name>Group</name>
      <width>135</width>
      <height>80</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="byte_monitor" version="2.0.0">
        <name>Byte Monitor_19</name>
        <pv_name>$(P)HPRF_SSA$(ssa):Status</pv_name>
        <width>20</width>
        <height>60</height>
        <numBits>3</numBits>
        <bitReverse>true</bitReverse>
        <horizontal>false</horizontal>
        <square>true</square>
        <off_color>
          <color name="OK" red="0" green="255" blue="0">
          </color>
        </off_color>
        <on_color>
          <color name="MAJOR" red="255" green="0" blue="0">
          </color>
        </on_color>
        <off_label>1</off_label>
        <on_label>0</on_label>
        <border_alarm_sensitive>false</border_alarm_sensitive>
      </widget>
      <widget type="label" version="2.0.0">
        <name>Label_94</name>
