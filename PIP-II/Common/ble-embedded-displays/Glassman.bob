    <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>0</value>
        </action>
      </actions>
      <pv_name>$(system)$(dev):OnOff</pv_name>
      <text>Set Off</text>
      <x>123</x>
      <y>48</y>
      <width>55</width>
      <height>31</height>
      <visible>false</visible>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <rules>
        <rule name="Show Off Button" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0=1">
            <value>true</value>
          </exp>
          <pv_name>$(system)$(dev):OnOffMonitor</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_1</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(system)$(dev):OnOff</pv_name>
      <text>Set On</text>
      <x>189</x>
      <y>48</y>
      <width>55</width>
      <height>31</height>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <rules>
        <rule name="Show On Button" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0=0">
            <value>true</value>
          </exp>
          <pv_name>$(system)$(dev):OnOffMonitor</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
