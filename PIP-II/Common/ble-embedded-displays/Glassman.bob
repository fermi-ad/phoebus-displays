          <description>WritePV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(PVprefix):CERR</pv_name>
      <text>Clear Errors</text>
      <x>180</x>
      <y>48</y>
      <width>103</width>
      <height>31</height>
