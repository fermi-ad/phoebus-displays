<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Sorrenson</name>
  <width>450</width>
  <height>350</height>
  <background_color>
    <color red="240" green="240" blue="240">
    </color>
  </background_color>
  <actions>
  </actions>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Sorensen Power Supply</text>
    <width>450</width>
    <height>30</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color name="acorn.White" red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color name="acorn.Black" red="38" green="38" blue="38">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
  <widget type="picture" version="2.0.0">
    <name>Picture</name>
    <file>../../../images/Sorensen.png</file>
    <x>259</x>
    <y>275</y>
    <width>190</width>
    <height>75</height>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>306</x>
    <y>34</y>
    <width>132</width>
    <height>67</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="led" version="2.0.0">
      <name>LED_1</name>
      <pv_name>$(system)$(dev):ModeMonitor</pv_name>
      <y>2</y>
      <width>23</width>
      <height>23</height>
      <foreground_color>
        <color red="192" green="192" blue="192">
        </color>
      </foreground_color>
      <actions>
      </actions>
      <rules>
        <rule name="Visibility" prop_id="visible" out_exp="false">
          <exp bool_exp="pvStr0 = &quot;YES&quot;">
            <value>false</value>
          </exp>
          <pv_name>loc://widget_disable</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="led" version="2.0.0">
      <name>LED_3</name>
      <pv_name>$(system)$(dev):ModeMonitor</pv_name>
      <y>39</y>
      <width>23</width>
      <height>23</height>
      <off_color>
        <color name="On" red="0" green="255" blue="0">
        </color>
      </off_color>
      <on_color>
        <color name="Off" red="60" green="100" blue="60">
        </color>
      </on_color>
      <foreground_color>
        <color red="192" green="192" blue="192">
        </color>
      </foreground_color>
      <actions>
      </actions>
      <rules>
        <rule name="Visitbility" prop_id="visible" out_exp="false">
          <exp bool_exp="pvStr0 = &quot;YES&quot;">
            <value>false</value>
          </exp>
          <pv_name>loc://widget_disable</pv_name>
        </rule>
      </rules>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>5</x>
    <y>35</y>
    <width>215</width>
    <height>68</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>Label_31</name>
