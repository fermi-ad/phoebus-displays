    <widget type="byte_monitor" version="2.0.0">
      <name>Byte Monitor_21</name>
      <pv_name>$(system)FLMNT:Status</pv_name>
      <x>10</x>
      <y>30</y>
      <width>20</width>
      <numBits>1</numBits>
      <bitReverse>true</bitReverse>
      <horizontal>false</horizontal>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="rectangle" version="2.0.0">
      <name>Rectangle_1</name>
      <macros>
        <pv_name></pv_name>
      </macros>
      <y>20</y>
      <width>215</width>
      <height>48</height>
      <line_width>1</line_width>
      <line_color>
        <color red="0" green="0" blue="0">
        </color>
      </line_color>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <actions>
      </actions>
      <tooltip>$(pv_name)
$(pv_value)</tooltip>
    </widget>
    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button_9</name>
      <pv_name>$(system)PLC2W2:wBIT</pv_name>
      <x>115</x>
      <y>30</y>
      <width>50</width>
      <height>20</height>
      <off_label>Enable</off_label>
      <off_color>
        <color red="240" green="240" blue="240">
        </color>
      </off_color>
      <on_label>Disable Extractor</on_label>
      <on_color>
        <color red="240" green="240" blue="240">
        </color>
      </on_color>
      <show_led>false</show_led>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <show_confirm_dialog>2</show_confirm_dialog>
      <confirm_message>Are your sure you want to Enable Extractor Supply?</confirm_message>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_14</name>
