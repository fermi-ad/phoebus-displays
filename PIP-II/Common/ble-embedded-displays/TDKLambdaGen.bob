      </color>
    </foreground_color>
    <background_color>
      <color red="0" green="76" blue="118" alpha="244">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <border_color>
      <color red="76" green="118" blue="244">
      </color>
    </border_color>
  </widget>
