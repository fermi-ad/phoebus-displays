  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>5</x>
    <y>35</y>
    <width>310</width>
    <height>110</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="rectangle" version="2.0.0">
      <name>Rectangle_1</name>
      <macros>
        <pv_name></pv_name>
      </macros>
      <y>20</y>
      <width>310</width>
      <height>90</height>
      <line_width>1</line_width>
      <line_color>
        <color red="0" green="0" blue="0">
        </color>
      </line_color>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <actions>
      </actions>
      <tooltip>$(pv_name)
$(pv_value)</tooltip>
    </widget>
    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button_11</name>
      <pv_name>$(system)$(plc):wBIT</pv_name>
      <x>110</x>
      <y>30</y>
      <width>50</width>
      <height>20</height>
      <off_label>Enable</off_label>
      <off_color>
        <color red="240" green="240" blue="240">
        </color>
      </off_color>
      <on_label>Disable</on_label>
      <on_color>
        <color red="240" green="240" blue="240">
        </color>
      </on_color>
      <show_led>false</show_led>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <show_confirm_dialog>2</show_confirm_dialog>
      <confirm_message>Are your sure you want to Enable Plasma Supply?</confirm_message>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_31</name>
      <text>Control</text>
      <width>310</width>
      <foreground_color>
        <color red="255" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="0" green="76" blue="118" alpha="244">
        </color>
      </background_color>
      <transparent>false</transparent>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
      <actions>
      </actions>
      <border_color>
        <color red="0" green="128" blue="255">
        </color>
      </border_color>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>0</value>
        </action>
      </actions>
      <pv_name>$(system)$(dev):sOffOn</pv_name>
      <text>Set Off</text>
      <x>110</x>
      <y>60</y>
      <width>50</width>
      <height>20</height>
      <visible>false</visible>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <rules>
        <rule name="Show Off Button" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0=1">
            <value>true</value>
          </exp>
          <pv_name>$(system)$(dev):OffOn</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <confirm_message></confirm_message>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_1</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(system)$(dev):sOffOn</pv_name>
      <text>Set On</text>
      <x>110</x>
      <y>60</y>
      <width>50</width>
      <height>20</height>
      <visible>false</visible>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <rules>
        <rule name="Show On Button" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0=0">
            <value>true</value>
          </exp>
          <pv_name>$(system)$(dev):OffOn</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <show_confirm_dialog>true</show_confirm_dialog>
      <confirm_message>Are your sure you want to turn output ON?</confirm_message>
    </widget>
    <widget type="led" version="2.0.0">
      <name>LED</name>
      <pv_name>$(system)$(dev):Status</pv_name>
      <bit>0</bit>
      <x>15</x>
