<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>ValveSimpleHoriz</name>
  <macros>
    <dev>$(dev)</dev>
  </macros>
  <width>68</width>
  <height>75</height>
  <widget type="symbol" version="2.0.0">
    <name>Symbol_29</name>
    <pv_name>$(system)$(dev):Open</pv_name>
    <symbols>
      <symbol>../../Images/Cryo/png/OnOffValveGray.png</symbol>
      <symbol>../../Images/Cryo/png/OnOffValveGreen.png</symbol>
    </symbols>
    <x>9</x>
    <width>45</width>
    <height>45</height>
    <actions>
    </actions>
    <run_actions_on_mouse_click>true</run_actions_on_mouse_click>
    <rules>
      <rule name="New Rule" prop_id="symbols[0]" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>../../Images/Cryo/png/OnOffValveGray.png</value>
        </exp>
        <exp bool_exp="pv0 &gt; 0">
          <value>../../Images/Cryo/png/OnOffValveGray.png</value>
        </exp>
        <pv_name>$(system)$(dev):Open</pv_name>
      </rule>
    </rules>
    <tooltip>$(pv_name)
$(pv_value)
$(actions)</tooltip>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_152</name>
    <macros>
      <dev>$(dev)</dev>
    </macros>
    <file>ValveStatusUp.bob</file>
    <y>39</y>
    <width>65</width>
    <height>35</height>
  </widget>
</display>
