  <widget type="label" version="2.0.0">
    <name>$(dev): Valve Control</name>
    <text>$(dev): Valve Control</text>
    <width>500</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="fgs.NAL-Blue" red="0" green="76" blue="151">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_width>1</border_width>
  </widget>
  <widget type="symbol" version="2.0.0">
    <name>Symbol_25</name>
    <pv_name>$(system)$(dev):VLVstat</pv_name>
    <symbols>
      <symbol>../../Images/Cryo/png/OnOffValveGray.png</symbol>
      <symbol>../../Images/Cryo/png/OnOffValveGreen.png</symbol>
      <symbol>../../Images/Cryo/png/OnOffValveRed.png</symbol>
    </symbols>
    <x>95</x>
    <y>249</y>
    <width>118</width>
    <height>81</height>
    <tooltip>$(pv_name)
$(pv_value)
$(actions)</tooltip>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED</name>
    <pv_name>$(system)$(dev):LimOpen</pv_name>
    <x>232</x>
    <y>163</y>
    <width>30</width>
    <height>30</height>
    <off_color>
      <color red="115" green="115" blue="115">
      </color>
    </off_color>
    <on_color>
      <color name="acorn.Green" red="82" green="171" blue="90">
      </color>
    </on_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
