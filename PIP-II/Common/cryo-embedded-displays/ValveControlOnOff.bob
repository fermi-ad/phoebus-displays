    <y>423</y>
    <width>1</width>
    <height>1</height>
  </widget>
  <widget type="byte_monitor" version="2.0.0">
    <name>Byte Monitor</name>
    <pv_name>$(system)$(dev):VLVfault</pv_name>
    <x>297</x>
    <y>255</y>
    <width>199</width>
    <height>117</height>
    <numBits>6</numBits>
    <horizontal>false</horizontal>
    <off_color>
      <color name="cryo.Off" red="150" green="150" blue="150">
      </color>
    </off_color>
    <on_color>
      <color name="cryo.Heater.On" red="229" green="56" blue="35">
      </color>
    </on_color>
    <labels>
      <text>Controller Fault</text>
      <text>Failed to Open</text>
      <text>Failed to Close</text>
      <text>Unexpected Movement</text>
      <text>Feedback Lost</text>
      <text>Valve Pos. Mismatch</text>
    </labels>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_103</name>
    <text>Valve Faults</text>
    <x>297</x>
    <y>230</y>
    <width>200</width>
    <height>22</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="cryo.Heater.On" red="229" green="56" blue="35">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <border_width>1</border_width>
  </widget>
