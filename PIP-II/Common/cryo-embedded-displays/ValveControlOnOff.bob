      </point>
      <point x="30.0" y="10.0">
      </point>
      <point x="35.0" y="0.0">
      </point>
      <point x="40.0" y="10.0">
      </point>
      <point x="42.5" y="5.0">
      </point>
      <point x="45.0" y="5.0">
      </point>
    </points>
    <line_color>
      <color red="255" green="0" blue="0">
      </color>
    </line_color>
    <arrow_length>10</arrow_length>
    <rules>
      <rule name="Heater On" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>$(htr)HTRVSL:HTRON</pv_name>
      </rule>
    </rules>
  </widget>
