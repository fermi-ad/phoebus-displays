  <widget type="polyline" version="2.0.0">
    <name>Polyline_105</name>
    <x>786</x>
    <y>87</y>
    <width>45</width>
    <height>10</height>
    <visible>false</visible>
    <points>
      <point x="0.0" y="5.0">
      </point>
      <point x="2.5" y="5.0">
      </point>
      <point x="5.0" y="0.0">
      </point>
      <point x="10.0" y="10.0">
      </point>
      <point x="15.0" y="0.0">
      </point>
