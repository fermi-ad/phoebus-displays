  <widget type="tank" version="2.0.0">
    <name>Tank</name>
    <x>648</x>
    <y>304</y>
    <width>1</width>
    <height>1</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Close</name>
    <actions>
      <action type="write_pv">
        <description>Close Valve</description>
        <pv_name>$(pv_name)</pv_name>
        <value>0</value>
      </action>
    </actions>
    <pv_name>$(system)$(dev):sOpen</pv_name>
    <text>CLOSE $(dev)</text>
    <x>18</x>
    <y>70</y>
    <width>122</width>
    <height>64</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>OPEN</name>
    <actions>
      <action type="write_pv">
        <description>Open Valve</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(system)$(dev):sOpen</pv_name>
    <text>OPEN $(dev)</text>
    <x>165</x>
    <y>69</y>
    <width>122</width>
    <height>64</height>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED_2</name>
