<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>TemperatureSensorDown</name>
  <width>65</width>
  <height>35</height>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_224</name>
    <pv_name>$(system)$(dev):Name</pv_name>
    <x>2</x>
    <y>17</y>
    <width>60</width>
    <height>15</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
    <precision>2</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <border_width>2</border_width>
    <border_color>
      <color red="0" green="255" blue="0">
      </color>
    </border_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_225</name>
    <pv_name>$(system)$(dev):Temp</pv_name>
    <x>2</x>
    <y>2</y>
    <width>60</width>
    <height>15</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
    <precision>2</precision>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <rules>
      <rule name="show units" prop_id="show_units" out_exp="false">
        <pv_name>$(pv_name)</pv_name>
      </rule>
    </rules>
    <border_width>2</border_width>
    <border_color>
      <color red="0" green="255" blue="0">
      </color>
    </border_color>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED</name>
    <pv_name>$(system)$(dev):BrknWr</pv_name>
    <x>54</x>
    <y>14</y>
    <width>10</width>
    <height>10</height>
    <off_label>OK</off_label>
    <off_color>
      <color name="OK" red="0" green="255" blue="0">
      </color>
    </off_color>
    <on_label>BKN</on_label>
    <on_color>
      <color name="MAJOR" red="255" green="0" blue="0">
      </color>
    </on_color>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="8.0">
      </font>
    </font>
  </widget>
</display>
