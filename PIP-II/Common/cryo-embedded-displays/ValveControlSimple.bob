    <pv_name>$(system)$(dev):VLVfault</pv_name>
    <x>445</x>
    <y>278</y>
    <width>198</width>
    <height>118</height>
    <numBits>6</numBits>
    <horizontal>false</horizontal>
    <off_color>
      <color name="cryo.Off" red="150" green="150" blue="150">
