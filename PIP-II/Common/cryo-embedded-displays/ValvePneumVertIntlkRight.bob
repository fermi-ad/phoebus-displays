<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>ValvePneumVertIntlkRight</name>
  <macros>
    <dev>$(dev)</dev>
  </macros>
  <width>100</width>
  <height>60</height>
  <widget type="led" version="2.0.0">
    <name>LED_8</name>
    <pv_name>$(system)$(dev):ManualAuto</pv_name>
    <bit>0</bit>
    <x>20</x>
    <off_label>A</off_label>
    <off_color>
      <color red="0" green="128" blue="0">
      </color>
    </off_color>
    <on_label>M</on_label>
    <on_color>
      <color name="fgs.Gray-45" red="167" green="168" blue="170">
      </color>
    </on_color>
    <square>true</square>
  </widget>
  <widget type="symbol" version="2.0.0">
    <name>Symbol_31</name>
    <pv_name>$(system)$(dev):VLVstat</pv_name>
    <symbols>
      <symbol>../../Images/Cryo/png/ControlValveGray.png</symbol>
      <symbol>../../Images/Cryo/png/ControlValveGreen.png</symbol>
      <symbol>../../Images/Cryo/png/ControlValveRed.png</symbol>
    </symbols>
    <y>15</y>
    <width>30</width>
    <height>30</height>
    <rotation>90.0</rotation>
    <actions>
    </actions>
    <tooltip>$(pv_name)
$(pv_value)
$(actions)</tooltip>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_198</name>
    <file>ValveStatusUp.bob</file>
    <x>40</x>
    <y>15</y>
    <width>65</width>
    <height>35</height>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED_25</name>
    <pv_name>$(system)$(intlk):INTLK</pv_name>
    <bit>0</bit>
    <x>20</x>
    <y>40</y>
    <off_label>I</off_label>
    <off_color>
      <color red="255" green="255" blue="0">
      </color>
    </off_color>
    <on_label>I</on_label>
    <on_color>
      <color red="255" green="255" blue="0">
      </color>
    </on_color>
    <line_color>
      <color red="153" green="51" blue="0">
      </color>
    </line_color>
    <square>true</square>
    <rules>
      <rule name="Visibilty" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0 == 0">
          <value>false</value>
        </exp>
        <pv_name>$(pv_name)</pv_name>
      </rule>
    </rules>
  </widget>
</display>
