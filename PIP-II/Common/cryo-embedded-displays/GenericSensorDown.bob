<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>TemperatureSensorDown</name>
  <width>65</width>
  <height>35</height>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_225</name>
    <pv_name>$(system)$(dev):$(sig)</pv_name>
    <x>2</x>
    <y>2</y>
    <width>60</width>
    <height>15</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
    <precision>2</precision>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <rules>
      <rule name="show units" prop_id="show_units" out_exp="false">
        <pv_name>$(pv_name)</pv_name>
      </rule>
    </rules>
    <border_width>2</border_width>
    <border_color>
      <color red="0" green="255" blue="0">
      </color>
    </border_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>$(name)</text>
    <x>2</x>
    <y>17</y>
    <width>60</width>
    <height>15</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_width>2</border_width>
    <border_color>
      <color red="0" green="255" blue="0">
      </color>
    </border_color>
  </widget>
</display>
