        <name>Label_19</name>
        <text>$(desc)
Vacuum</text>
        <height>35</height>
        <background_color>
          <color name="Button_Background" red="210" green="210" blue="210">
          </color>
        </background_color>
        <transparent>false</transparent>
        <horizontal_alignment>1</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
        <border_width>1</border_width>
      </widget>
      <widget type="textupdate" version="2.0.0">
        <name>Text Update_308</name>
        <pv_name>$(system)$(dev1):Name</pv_name>
        <y>50</y>
        <height>15</height>
        <visible>false</visible>
        <font>
          <font family="Liberation Sans" style="BOLD" size="12.0">
          </font>
        </font>
        <foreground_color>
          <color name="Attention" red="255" green="160" blue="0">
          </color>
        </foreground_color>
        <background_color>
          <color red="44" green="44" blue="44">
          </color>
        </background_color>
        <show_units>false</show_units>
        <horizontal_alignment>1</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
        <wrap_words>false</wrap_words>
        <rules>
          <rule name="Show Name" prop_id="visible" out_exp="false">
            <exp bool_exp="pv0&gt;2e-3">
              <value>true</value>
            </exp>
            <pv_name>$(system)$(dev1):VacP</pv_name>
          </rule>
        </rules>
        <border_alarm_sensitive>false</border_alarm_sensitive>
      </widget>
