<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Vacuum</name>
  <width>115</width>
  <height>80</height>
  <background_color>
    <color name="Read_Background" red="240" green="240" blue="240">
    </color>
  </background_color>
  <widget type="group" version="3.0.0">
    <name>Group_3</name>
    <width>115</width>
    <height>80</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="group" version="3.0.0">
      <name>Group_6</name>
      <width>100</width>
      <height>80</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="rectangle" version="2.0.0">
        <name>Rectangle_11</name>
        <y>35</y>
        <height>45</height>
        <line_width>1</line_width>
        <line_color>
          <color red="0" green="0" blue="0">
          </color>
        </line_color>
        <background_color>
          <color name="Read_Background" red="240" green="240" blue="240">
          </color>
        </background_color>
      </widget>
