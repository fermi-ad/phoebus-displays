  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>5</x>
    <y>70</y>
    <width>125</width>
    <height>50</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button_4</name>
      <pv_name>$(P)$(R):sc_OnOff</pv_name>
      <x>15</x>
      <y>20</y>
      <width>110</width>
      <off_label>Start Pump</off_label>
      <off_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </off_color>
      <on_label>Stop Pump</on_label>
      <on_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </on_color>
      <show_led>false</show_led>
      <rules>
        <rule name="Off Label" prop_id="off_label" out_exp="false">
          <exp bool_exp="p0=0">
            <value>Start Pump</value>
          </exp>
          <pv_name>$(P)$(R):rv_StatusRegister1.B1</pv_name>
        </rule>
        <rule name="On Label" prop_id="on_label" out_exp="false">
          <exp bool_exp="p0=1">
            <value>Stop Pump</value>
          </exp>
          <pv_name>$(P)$(R):rv_StatusRegister1.B1</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <show_confirm_dialog>1</show_confirm_dialog>
    </widget>
