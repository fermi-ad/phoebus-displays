      <x>114</x>
      <y>25</y>
      <width>30</width>
      <height>30</height>
      <states>
        <state>
          <value>1</value>
          <label>Ok</label>
          <color>
            <color name="OK" red="0" green="255" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>2</value>
          <label>Warning</label>
          <color>
            <color name="Attention" red="255" green="160" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>3</value>
          <label>Critical</label>
          <color>
            <color name="MAJOR" red="255" green="0" blue="0">
            </color>
          </color>
        </state>
      </states>
      <fallback_label>Unknown</fallback_label>
    </widget>
