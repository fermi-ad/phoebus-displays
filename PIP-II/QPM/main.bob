<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>QPM</name>
  <width>1325</width>
  <height>875</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_Area8TitleBar</class>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>1325</width>
    <height use_class="true">50</height>
    <line_width use_class="true">0</line_width>
    <background_color use_class="true">
      <color name="EDE Area8 Color" red="170" green="210" blue="240">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Header</class>
    <text>$(DEV_NAME)</text>
    <y use_class="true">0</y>
    <width>1325</width>
    <height use_class="true">50</height>
    <font use_class="true">
      <font name="EDE Title Bar" family="sans" style="REGULAR" size="28.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <horizontal_alignment use_class="true">1</horizontal_alignment>
    <vertical_alignment use_class="true">1</vertical_alignment>
    <auto_size use_class="true">false</auto_size>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <file>resources/qpm_top.bob</file>
    <y>50</y>
    <width>1325</width>
    <height>835</height>
    <resize>2</resize>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>qhwr1</DEVICE>
          <DEV_NAME>QHWR1</DEV_NAME>
          <QPC1>Sol 1</QPC1>
          <QPC2>Vert Corr 1</QPC2>
          <QPC3>Horz Corr 1</QPC3>
          <QPC4>Sol 2</QPC4>
          <QPC5>Vert Corr 2</QPC5>
          <QPC6>Horz Corr 2</QPC6>
        </macros>
        <target>replace</target>
        <description>QHWR1</description>
      </action>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>WFE:QPM_PESD_qhwr2</DEVICE>
          <DEV_NAME>QHWR2</DEV_NAME>
          <QPC1>Sol 3</QPC1>
          <QPC2>Vert Corr 3</QPC2>
          <QPC3>Horz Corr 3</QPC3>
          <QPC4>Sol 4</QPC4>
          <QPC5>Vert Corr 4</QPC5>
          <QPC6>Horz Corr 4</QPC6>
        </macros>
        <target>replace</target>
        <description>QHWR2</description>
      </action>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>qhwr3</DEVICE>
          <DEV_NAME>QHWR3</DEV_NAME>
          <QPC1>Sol 5</QPC1>
          <QPC2>Vert Corr 5</QPC2>
          <QPC3>Horz Corr 5</QPC3>
          <QPC4>Sol 6</QPC4>
          <QPC5>Vert Corr 6</QPC5>
          <QPC6>Horz Corr 6</QPC6>
        </macros>
        <target>replace</target>
        <description>QHWR3</description>
      </action>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>qhwr4</DEVICE>
          <DEV_NAME>QHWR4</DEV_NAME>
          <QPC1>Sol 7</QPC1>
          <QPC2>Vert Corr 7</QPC2>
          <QPC3>Horz Corr 7</QPC3>
          <QPC4>Sol 8</QPC4>
          <QPC5>Vert Corr 8</QPC5>
          <QPC6>Horz Corr 8</QPC6>
        </macros>
        <target>replace</target>
        <description>QHWR4</description>
      </action>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>qssr11</DEVICE>
          <DEV_NAME>QSSR11</DEV_NAME>
          <QPC1>Sol 1</QPC1>
          <QPC2>Corr 1-1</QPC2>
          <QPC3>Corr 1-2</QPC3>
          <QPC4>Corr 1-3</QPC4>
          <QPC5>Corr 1-4</QPC5>
          <QPC6>N/A</QPC6>
        </macros>
        <target>replace</target>
        <description>QSSR11</description>
      </action>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>qssr12</DEVICE>
          <DEV_NAME>QSSR12</DEV_NAME>
          <QPC1>Sol 2</QPC1>
          <QPC2>Corr 2-1</QPC2>
          <QPC3>Corr 2-2</QPC3>
          <QPC4>Corr 2-3</QPC4>
          <QPC5>Corr 2-4</QPC5>
          <QPC6>N/A</QPC6>
        </macros>
        <target>replace</target>
        <description>QSSR12</description>
      </action>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>qssr13</DEVICE>
          <DEV_NAME>QSSR13</DEV_NAME>
          <QPC1>Sol 3</QPC1>
          <QPC2>Corr 3-1</QPC2>
          <QPC3>Corr 3-2</QPC3>
          <QPC4>Corr 3-3</QPC4>
          <QPC5>Corr 3-4</QPC5>
          <QPC6>N/A</QPC6>
        </macros>
        <target>replace</target>
        <description>QSSR13</description>
      </action>
      <action type="open_display">
        <file>main.bob</file>
        <macros>
          <DEVICE>qssr14</DEVICE>
          <DEV_NAME>QSSR14</DEV_NAME>
          <QPC1>Sol 4</QPC1>
          <QPC2>Corr 4-1</QPC2>
          <QPC3>Corr 4-2</QPC3>
          <QPC4>Corr 4-3</QPC4>
          <QPC5>Corr 4-4</QPC5>
          <QPC6>N/A</QPC6>
        </macros>
        <target>replace</target>
        <description>QSSR14</description>
      </action>
    </actions>
    <text>Select QPM...</text>
    <x>10</x>
    <y>15</y>
    <height>22</height>
    <font>
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="EDE BackgroundButton" red="200" green="200" blue="200">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
</display>
