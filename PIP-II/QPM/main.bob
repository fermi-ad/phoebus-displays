<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>QPM</name>
  <macros>
    <IOC_PREFIX>PIP2IT:QPM_PESD_</IOC_PREFIX>
    <QPM_INITIALIZED>0</QPM_INITIALIZED>
  </macros>
  <width>1325</width>
  <height>875</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_Area8TitleBar</class>
    <width>1325</width>
    <height>50</height>
    <line_width>0</line_width>
    <background_color>
      <color name="EDE Area8 Color" red="170" green="210" blue="240">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Header</class>
    <text>$(DEV_NAME)</text>
    <width>1325</width>
    <height>50</height>
    <font>
      <font name="EDE Title Bar" family="sans" style="REGULAR" size="28.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <macros>
      <QPC_TAB_NUM>$(QPC_SEL)</QPC_TAB_NUM>
    </macros>
    <file>resources/qpm_top.bob</file>
    <y>50</y>
    <width>1325</width>
    <height>835</height>
    <resize>2</resize>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>QHWR1</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qhwr1</DEVICE>
          <DEV_NAME>QHWR1</DEV_NAME>
          <QPC1>QPC1</QPC1>
          <QPC2>QPC2</QPC2>
          <QPC3>QPC3</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QHWR2</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qhwr2</DEVICE>
          <DEV_NAME>QHWR2</DEV_NAME>
          <QPC1>QPC1</QPC1>
          <QPC2>QPC2</QPC2>
          <QPC3>QPC3</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QHWR3</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qhwr3</DEVICE>
          <DEV_NAME>QHWR3</DEV_NAME>
          <QPC1>QPC1</QPC1>
          <QPC2>QPC2</QPC2>
          <QPC3>QPC3</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QHWR4</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qhwr4</DEVICE>
          <DEV_NAME>QHWR4</DEV_NAME>
          <QPC1>QPC1</QPC1>
          <QPC2>QPC2</QPC2>
          <QPC3>QPC3</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QSSR11</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qssr11</DEVICE>
          <DEV_NAME>QSSR11</DEV_NAME>
          <QPC1>Sol1</QPC1>
          <QPC2>Cor1-1</QPC2>
          <QPC3>Cor1-2</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QSSR12</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qssr12</DEVICE>
          <DEV_NAME>QSSR12</DEV_NAME>
          <QPC1>Sol2</QPC1>
          <QPC2>Cor2-1</QPC2>
          <QPC3>Cor2-2</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QSSR13</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qssr13</DEVICE>
          <DEV_NAME>QSSR13</DEV_NAME>
          <QPC1>QPC1</QPC1>
          <QPC2>QPC2</QPC2>
          <QPC3>QPC3</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QSSR14</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>$(IOC_PREFIX)qssr14</DEVICE>
          <DEV_NAME>QSSR14</DEV_NAME>
          <QPC1>Sol3</QPC1>
          <QPC2>Cor3-1</QPC2>
          <QPC3>Cor3-2</QPC3>
          <QPC4>QPC4</QPC4>
          <QPC5>QPC5</QPC5>
          <QPC6>QPC6</QPC6>
        </macros>
        <target>replace</target>
      </action>
    </actions>
    <text>Select QPM...</text>
    <x>10</x>
    <y>15</y>
    <height>22</height>
    <font>
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="EDE BackgroundButton" red="200" green="200" blue="200">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Macro Debug</name>
  <text>DEVICE=$(DEVICE) | QPC1=$(QPC1) | QPC2=$(QPC2)</text>
    <visible>false</visible>
    <x>10</x>
    <y>900</y>
    <width>1200</width>
    <height>30</height>
    <scripts>
      <script file="initialize.py" check_connections="false">
        <pv_name>loc://startup(1)</pv_name>
      </script>
    </scripts>
  </widget>
</display>
