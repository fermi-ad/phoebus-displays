<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>EDE_rb-combo</name>
  <width>400</width>
  <height>30</height>
  <background_color use_class="true">
    <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <class>EDE_TextUpd</class>
    <pv_name>$(RB_PV)</pv_name>
    <x>300</x>
    <y>4</y>
    <width>90</width>
    <height use_class="true">22</height>
    <font use_class="true">
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Black" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="EDE ThemeVariationLigher3" red="240" green="240" blue="240">
      </color>
    </background_color>
    <horizontal_alignment use_class="true">1</horizontal_alignment>
    <vertical_alignment use_class="true">1</vertical_alignment>
    <border_width use_class="true">1</border_width>
    <border_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </border_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Label</class>
    <text>$(DESC)</text>
    <x>10</x>
    <width>180</width>
    <height>30</height>
    <font use_class="true">
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Black" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>Text Entry</name>
    <class>EDE_Combobox</class>
    <pv_name>$(SP_PV)</pv_name>
    <x>200</x>
    <y>4</y>
    <width>90</width>
    <height use_class="true">22</height>
    <font use_class="true">
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Black" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="EDE ThemeVariationLigher4" red="250" green="250" blue="250">
      </color>
    </background_color>
  </widget>
</display>
