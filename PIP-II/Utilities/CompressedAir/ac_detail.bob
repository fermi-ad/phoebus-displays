<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>$(LABEL) Detail</name>
  <width>520</width>
  <height>410</height>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <width>520</width>
    <height>35</height>
    <line_color>
      <color red="0" green="51" blue="102">
      </color>
    </line_color>
    <background_color>
      <color red="0" green="51" blue="102">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>$(LABEL) — Air Compressor Detail</text>
    <x>10</x>
    <y>4</y>
    <width>360</width>
    <height>28</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_1</name>
    <x>10</x>
    <y>45</y>
    <width>500</width>
    <height>95</height>
    <line_color>
      <color red="200" green="200" blue="200">
      </color>
    </line_color>
    <background_color>
      <color red="248" green="248" blue="248">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>Status</text>
    <x>18</x>
    <y>48</y>
    <width>120</width>
    <height>18</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="12.0">
      </font>
    </font>
    <foreground_color>
      <color red="0" green="51" blue="102">
      </color>
    </foreground_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <text>Error</text>
    <x>18</x>
    <y>70</y>
    <width>140</width>
    <height>60</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="16.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color name="INVALID" red="255" green="0" blue="255">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="Trip_color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>
            <color name="MAJOR" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(PREFIX):$(UNIT)_isTripPresent</pv_name>
      </rule>
      <rule name="Trip_text" prop_id="text" out_exp="true">
        <exp bool_exp="pv0 == 1">
          <expression>"TRIP"</expression>
        </exp>
        <pv_name>$(PREFIX):$(UNIT)_isTripPresent</pv_name>
      </rule>
      <rule name="Warn_color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>
            <color name="MINOR" red="255" green="128" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(PREFIX):$(UNIT)_isWarningPresent</pv_name>
      </rule>
      <rule name="Warn_text" prop_id="text" out_exp="true">
        <exp bool_exp="pv0 == 1">
          <expression>"WARNING"</expression>
        </exp>
        <pv_name>$(PREFIX):$(UNIT)_isWarningPresent</pv_name>
      </rule>
      <rule name="OK_color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>
            <color name="MAJOR" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(PREFIX):$(UNIT)_isTripPresent</pv_name>
      </rule>
      <rule name="OK_text" prop_id="text" out_exp="true">
        <exp bool_exp="pv0 == 0">
          <expression>"OK"</expression>
        </exp>
        <pv_name>$(PREFIX):$(UNIT)_isTripPresent</pv_name>
      </rule>
    </rules>
  </widget>
