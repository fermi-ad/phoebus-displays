  <widget type="label" version="2.0.0">
    <name>AC1_State</name>
    <text>NO DATA</text>
    <x>90</x>
    <y>285</y>
    <width>110</width>
    <height>18</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="11.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="StateText" prop_id="text" out_exp="true">
        <exp bool_exp="pv0 == 1">
          <expression>"OFFLINE"</expression>
        </exp>
        <exp bool_exp="pv1 == 1">
          <expression>"TRIP"</expression>
        </exp>
        <exp bool_exp="pv2 == 1">
          <expression>"LL TRIP"</expression>
        </exp>
        <exp bool_exp="pv3 == 1">
          <expression>"WARNING"</expression>
        </exp>
        <exp bool_exp="pv4 == 1">
          <expression>"ACTIVE"</expression>
        </exp>
        <exp bool_exp="pv0 == 0 &amp;&amp; pv1 == 0 &amp;&amp; pv2 == 0 &amp;&amp; pv3 == 0 &amp;&amp; pv4 == 0">
          <expression>"OFF"</expression>
        </exp>
        <pv_name>LACC:UTIL_MSD_CMPRAC1:IsOffline</pv_name>
        <pv_name>LACC:UTIL_MSD_CMPRAC1:TripStatus</pv_name>
        <pv_name>LACC:UTIL_MSD_CMPRAC1:LLTrip</pv_name>
        <pv_name>LACC:UTIL_MSD_CMPRAC1:WarningStatus</pv_name>
        <pv_name>LACC:UTIL_MSD_CMPRAC1:IsActive</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
