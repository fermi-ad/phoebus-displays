      </color>
    </background_color>
    <rules>
      <rule name="Trip" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>
            <color red="255" green="60" blue="60">
            </color>
          </value>
        </exp>
        <pv_name>LACC:UTIL_MSD_CMPR:AC1_isTripPresent</pv_name>
      </rule>
      <rule name="Warning" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>
            <color red="255" green="210" blue="60">
            </color>
          </value>
        </exp>
        <pv_name>LACC:UTIL_MSD_CMPR:AC1_isWarningPresent</pv_name>
      </rule>
      <rule name="OK" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 0 &amp;&amp; pv1 == 0">
          <value>
            <color red="200" green="235" blue="200">
            </color>
          </value>
        </exp>
        <pv_name>LACC:UTIL_MSD_CMPR:AC1_isTripPresent</pv_name>
        <pv_name>LACC:UTIL_MSD_CMPR:AC1_isWarningPresent</pv_name>
      </rule>
    </rules>
  </widget>
