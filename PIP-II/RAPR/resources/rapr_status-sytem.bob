<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>rapr_status-system</name>
  <width>450</width>
  <height>350</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_BarHeavy</class>
    <y>15</y>
    <width>450</width>
    <height>3</height>
    <line_color>
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </line_color>
    <background_color>
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Title</class>
    <text>$(DEVICE) Status</text>
    <x>50</x>
    <width>204</width>
    <height>21</height>
    <font>
      <font name="EDE Header" family="sans" style="BOLD" size="18.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
      </color>
    </background_color>
    <transparent>false</transparent>
    <auto_size>true</auto_size>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <y>37</y>
    <width>400</width>
    <height>356</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_9</name>
      <macros>
        <DESC>Interlock Sum Status:</DESC>
        <PV>$(DEVICE):System_Status_B8_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>240</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_8</name>
      <macros>
        <DESC>Control PS Status:</DESC>
        <PV>$(DEVICE):System_Status_B7_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>210</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_7</name>
      <macros>
        <DESC>ESS Status:</DESC>
        <PV>$(DEVICE):System_Status_B6_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>180</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_6</name>
      <macros>
        <DESC>Air Flow / Water Pressure Switches:</DESC>
        <PV>$(DEVICE):System_Status_B5_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>150</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_5</name>
      <macros>
        <DESC>Door Status:</DESC>
        <PV>$(DEVICE):System_Status_B4_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>120</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_4</name>
      <macros>
        <DESC>Contactor Status:</DESC>
        <PV>$(DEVICE):System_Status_B3_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>90</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_3</name>
      <macros>
        <DESC>Smoke Detector:</DESC>
        <PV>$(DEVICE):System_Status_B2_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>60</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_2</name>
      <macros>
        <DESC>Phase Loss Detector After Contactor:</DESC>
        <PV>$(DEVICE):System_Status_B1_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <y>30</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_1</name>
      <macros>
        <DESC>Phase Loss Detector Before Contactor:</DESC>
        <PV>$(DEVICE):System_Status_B0_RB</PV>
      </macros>
      <file>../widget-library/status_error-ok.bob</file>
      <height>30</height>
      <resize>2</resize>
    </widget>
  </widget>
</display>
