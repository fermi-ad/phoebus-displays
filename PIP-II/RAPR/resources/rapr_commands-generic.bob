<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>rapr_commands-generic</name>
  <width>500</width>
  <height>75</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <class>EDE_Label</class>
    <text>$(PS$(NUM)) Commands:</text>
    <x>8</x>
    <y>32</y>
    <width>220</width>
    <height>30</height>
    <font use_class="true">
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>Text Entry</name>
    <class>EDE_Spinner</class>
    <pv_name>$(DEVICE):$(PS$(NUM)):Control_SP</pv_name>
    <x>326</x>
    <y>36</y>
    <width>170</width>
    <height>22</height>
    <font>
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="EDE BackgroundSetpoint" red="250" green="250" blue="250">
      </color>
    </background_color>
    <items>
      <item></item>
    </items>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_BarHeavy</class>
    <y>15</y>
    <width>500</width>
    <height use_class="true">3</height>
    <line_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </line_color>
    <background_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Title</class>
    <text>Commands</text>
    <x>203</x>
    <width>95</width>
    <height>27</height>
    <font use_class="true">
      <font name="EDE Header" family="sans" style="BOLD" size="18.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
      </color>
    </background_color>
    <transparent>false</transparent>
    <auto_size>true</auto_size>
  </widget>
</display>
