    <macros>
      <LABEL>Reset Count</LABEL>
      <PV>$(DEVICE)_ErrorCountReset_SP.PROC</PV>
      <VALUE>1</VALUE>
    </macros>
    <file>../widget-library/button.bob</file>
    <x>399</x>
    <y>159</y>
    <width>90</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <class>EDE_Title</class>
    <text>General Connection Status and Control</text>
    <x>85</x>
    <y>10</y>
    <width>397</width>
    <height>21</height>
