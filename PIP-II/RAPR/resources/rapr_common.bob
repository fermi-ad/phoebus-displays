<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>rapr_common</name>
  <width>1325</width>
  <height>800</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_1</name>
    <class>EDE_BarHeavy</class>
    <y>22</y>
    <width>500</width>
    <height>3</height>
    <line_color>
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </line_color>
    <background_color>
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </background_color>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>EDE_rb</name>
    <macros>
      <DESC>Connection Status</DESC>
      <PV>$(DEVICE)_ConnStatus_RB</PV>
    </macros>
    <file>../widget-library/readback.bob</file>
    <y>40</y>
    <width>500</width>
    <height>30</height>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>EDE_rb-sp_4</name>
    <macros>
      <LABEL>Connect</LABEL>
      <PV>$(DEVICE)_ConnEnable_SP.PROC</PV>
      <VALUE>1</VALUE>
    </macros>
    <file>../widget-library/button.bob</file>
    <x>306</x>
    <y>69</y>
    <width>90</width>
    <height>30</height>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>EDE_rb-sp_6</name>
    <macros>
      <LABEL>Disconnect</LABEL>
      <PV>$(DEVICE)_ConnDisable_SP.PROC</PV>
      <VALUE>1</VALUE>
    </macros>
    <file>../widget-library/button.bob</file>
    <x>399</x>
    <y>69</y>
    <width>90</width>
    <height>30</height>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>EDE_rb-sp_7</name>
    <macros>
      <DESC>Message count</DESC>
      <PV>$(DEVICE)_MsgCount_RB</PV>
    </macros>
    <file>../widget-library/readback.bob</file>
    <y>100</y>
    <width>500</width>
    <height>30</height>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>EDE_rb-sp_8</name>
    <macros>
      <DESC>Error count</DESC>
