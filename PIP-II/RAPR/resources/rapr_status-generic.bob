<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>rapr_status-generic</name>
  <width>810</width>
  <height>405</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_BarHeavy</class>
    <y>15</y>
    <width>810</width>
    <height use_class="true">3</height>
    <line_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </line_color>
    <background_color use_class="true">
      <color name="EDE Border Dark" red="128" green="128" blue="128">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Title</class>
    <text>$(PS$(NUM)) Status</text>
    <x>312</x>
    <width>186</width>
    <height>24</height>
    <font use_class="true">
      <font name="EDE Header" family="sans" style="BOLD" size="18.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
      </color>
    </background_color>
    <transparent>false</transparent>
    <auto_size>true</auto_size>
  </widget>
  <widget type="group" version="2.0.0">
    <name>Group</name>
    <x>405</x>
    <y>37</y>
    <width>400</width>
    <height>356</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_24</name>
      <macros>
        <DESC>Slew Up Mode:</DESC>
        <PV>$(DEVICE):$(PS$(NUM)):Status_B30_RB</PV>
      </macros>
      <file>../widget-library/status_ok-ok.bob</file>
      <y>270</y>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
