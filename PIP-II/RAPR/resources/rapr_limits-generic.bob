<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>qpm_limits-generic</name>
  <width>500</width>
  <height>825</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <width>500</width>
    <height>24</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="rectangle" version="2.0.0">
      <name>Rectangle</name>
      <class>EDE_BarHeavy</class>
      <y>15</y>
      <width>500</width>
      <height>3</height>
      <line_color>
        <color name="EDE Border Dark" red="128" green="128" blue="128">
        </color>
      </line_color>
      <background_color>
        <color name="EDE Border Dark" red="128" green="128" blue="128">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label</name>
      <class>EDE_Title</class>
      <text>Analog Signals</text>
      <x>175</x>
      <width>151</width>
      <height>21</height>
      <font>
        <font name="EDE Header" family="sans" style="BOLD" size="18.0">
        </font>
      </font>
      <foreground_color>
        <color name="EDE Text Main" red="0" green="0" blue="0">
        </color>
      </foreground_color>
      <background_color>
        <color name="EDE ThemeVariationLigher1" red="225" green="225" blue="225">
        </color>
      </background_color>
      <transparent>false</transparent>
      <auto_size>true</auto_size>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <y>417</y>
    <width>500</width>
    <height>398</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="group" version="3.0.0">
      <name>Group</name>
      <y>1</y>
      <width>500</width>
      <height>24</height>
      <style>3</style>
      <transparent>true</transparent>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <y>28</y>
    <width>500</width>
    <height>390</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_5</name>
      <macros>
        <DESC>$(PS$(NUM)) V PS:</DESC>
        <PV>$(DEVICE):$(PS$(NUM)):PS_V_RB</PV>
      </macros>
      <file>../widget-library/readback.bob</file>
      <y>120</y>
      <width>500</width>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_4</name>
      <macros>
        <DESC>$(PS$(NUM)) I Error:</DESC>
        <PV>$(DEVICE):$(PS$(NUM)):I_Err_RB</PV>
      </macros>
      <file>../widget-library/readback.bob</file>
      <y>90</y>
      <width>500</width>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_3</name>
      <macros>
        <DESC>$(PS$(NUM)) I Load:</DESC>
        <PV>$(DEVICE):$(PS$(NUM)):I_Load_RB</PV>
      </macros>
      <file>../widget-library/readback.bob</file>
      <y>60</y>
      <width>500</width>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_2</name>
      <macros>
        <DESC>$(PS$(NUM)) I Ref Loopback:</DESC>
        <PV>$(DEVICE):$(PS$(NUM)):I_Ref_Lpbk_RB</PV>
      </macros>
      <file>../widget-library/readback.bob</file>
      <y>30</y>
      <width>500</width>
      <height>30</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display_1</name>
      <macros>
        <DESC>$(PS$(NUM)) I Ref:</DESC>
        <RB_PV>$(DEVICE):$(PS$(NUM)):I_Ref_RB</RB_PV>
        <SP_PV>$(DEVICE):$(PS$(NUM)):I_Ref_SP</SP_PV>
      </macros>
      <file>../widget-library/readback&amp;setpoint.bob</file>
      <width>500</width>
      <height>30</height>
      <resize>2</resize>
    </widget>
  </widget>
</display>
