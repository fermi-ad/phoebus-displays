<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <macros>
    <Plot_RB>$(DEVICE):Plot_PS_SEL_RB</Plot_RB>
    <Plot_SP>$(DEVICE):Plot_PS_SEL_SP</Plot_SP>
    <Plot_PS1>$(DEVICE):$(PS1)</Plot_PS1>
    <Plot_PS2>$(DEVICE):$(PS2)</Plot_PS2>
    <Plot_PS3>$(DEVICE):$(PS3)</Plot_PS3>
    <Plot_PS4>$(DEVICE):$(PS4)</Plot_PS4>
    <Plot_PS></Plot_PS>
  </macros>
  <width>1325</width>
  <height>625</height>
  <background_color>
    <color name="Transparent" red="255" green="255" blue="255" alpha="0">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <y>20</y>
    <width>1300</width>
    <height>3</height>
    <line_color>
      <color name="acorn.GroupTitleAndBorder.Dark" red="82" green="82" blue="82">
      </color>
    </line_color>
    <background_color>
      <color name="acorn.GroupTitleAndBorder.Dark" red="82" green="82" blue="82">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>Label</class>
    <macros>
      <PS_SEL>$(plot_title)</PS_SEL>
    </macros>
    <text>$(DEVICE)</text>
    <x>600</x>
    <width>109</width>
    <height>25</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <background_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </background_color>
    <transparent>false</transparent>
    <auto_size>true</auto_size>
    <rules>
      <rule name="New Rule" prop_id="text" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>$(PS1)</value>
        </exp>
        <exp bool_exp="pv0 ==  1">
          <value>$(PS2)</value>
        </exp>
        <exp bool_exp="pv0 == 2">
          <value>$(PS3)</value>
        </exp>
        <exp bool_exp="pv0 == 3">
          <value>$(PS4)</value>
        </exp>
        <pv_name>$(Plot_SP)</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot</name>
    <x>203</x>
    <y>46</y>
    <width>1100</width>
    <height>550</height>
    <x_axis>
      <title>Time</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>false</show_grid>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Y</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>10.0</maximum>
        <show_grid>false</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>i_ref</name>
        <x_pv></x_pv>
        <y_pv>$(DEVICE):Plot_Data_1_RB</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>i_meas</name>
        <x_pv></x_pv>
        <y_pv>$(DEVICE):Plot_Data_2_RB</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="255" green="0" blue="0">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>i_err</name>
        <x_pv></x_pv>
        <y_pv>$(DEVICE):Plot_Data_3_RB</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="255" blue="0">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>v_ps</name>
        <x_pv></x_pv>
        <y_pv>$(DEVICE):Plot_Data_4_RB</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="170" green="0" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="write_pv">
        <description>$(PS1)</description>
        <pv_name>$(Plot_SP)</pv_name>
        <value>0</value>
      </action>
      <action type="write_pv">
        <description>$(PS2)</description>
        <pv_name>$(Plot_SP)</pv_name>
        <value>1</value>
      </action>
      <action type="write_pv">
        <description>$(PS3)</description>
        <pv_name>$(Plot_SP)</pv_name>
        <value>2</value>
      </action>
      <action type="write_pv">
        <description>$(PS4)</description>
        <pv_name>$(Plot_SP)</pv_name>
        <value>3</value>
      </action>
    </actions>
    <text>Select</text>
    <x>20</x>
    <y>46</y>
    <width>170</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Plot</name>
    <pv_name>$(Plot_SP)</pv_name>
    <x>20</x>
    <y>360</y>
    <width>160</width>
    <height>30</height>
    <visible>false</visible>
    <show_units>false</show_units>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(plot_title)</pv_name>
        <value>$(DEVICE):Plot_PS_SEL_RB</value>
      </action>
    </actions>
  </widget>
</display>
