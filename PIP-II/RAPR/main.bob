<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>RAPR</name>
  <width>1325</width>
  <height>875</height>
  <background_color>
    <color name="EDE BackgroundDisplay" red="225" green="225" blue="225">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <class>EDE_Area8TitleBar</class>
    <width>1325</width>
    <height>50</height>
    <line_width>0</line_width>
    <background_color>
      <color name="EDE Area8 Color" red="170" green="210" blue="240">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>EDE_Header</class>
    <text>$(DEV_NAME)</text>
    <width>1325</width>
    <height>50</height>
    <font>
      <font name="EDE Title Bar" family="sans" style="REGULAR" size="28.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <file>resources/rapr_top.bob</file>
    <y>50</y>
    <width>1325</width>
    <height>835</height>
    <resize>2</resize>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>RAPR01-TEST</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>PIP2:rapr01-test</DEVICE>
          <DEV_NAME>RAPR01-TEST</DEV_NAME>
          <PS1>P:PS1</PS1>
          <PS2>P:PS2</PS2>
          <PS3>P:PS3</PS3>
          <PS4>P:PS4</PS4>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>RAPR02-DEV</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>PIP2:rapr02-dev</DEVICE>
          <DEV_NAME>RAPR02-DEV</DEV_NAME>
          <PS1>P:PS5</PS1>
          <PS2>P:PS6</PS2>
          <PS3>P:PS7</PS3>
          <PS4>P:PS8</PS4>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QUAD_MAGPS_RAPR04</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>WFE:QUAD_MAGPS_rapr04</DEVICE>
          <DEV_NAME>QUAD_MAGPS_rapr04</DEV_NAME>
          <PS1>Z:TST1</PS1>
          <PS2>Z:TST2</PS2>
          <PS3>Z:TST3</PS3>
          <PS4>Z:TST4</PS4>
        </macros>
        <target>replace</target>
      </action>
      <action type="open_display">
        <description>QUAD_MAGPS_rapr05</description>
        <file>main.bob</file>
        <macros>
          <DEVICE>WFE:QUAD_MAGPS_rapr05</DEVICE>
          <DEV_NAME>QUAD_MAGPS_rapr05</DEV_NAME>
          <PS1>Z:R5P1</PS1>
          <PS2>Z:R5P2</PS2>
          <PS3>Z:R5P3</PS3>
          <PS4>Z:R5P4</PS4>
        </macros>
        <target>replace</target>
      </action>
    </actions>
    <text>Select RAPR...</text>
    <x>10</x>
    <y>15</y>
    <height>22</height>
    <font>
      <font name="EDE Label" family="sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="EDE Text Main" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="EDE BackgroundButton" red="200" green="200" blue="200">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
</display>
