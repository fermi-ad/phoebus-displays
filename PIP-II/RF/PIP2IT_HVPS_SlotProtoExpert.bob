  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot_1</name>
    <x>60</x>
    <y>490</y>
    <width>770</width>
    <height>320</height>
    <show_toolbar>true</show_toolbar>
    <rules>
      <rule name="Show_trace_raw" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0&gt;0">
          <value>false</value>
        </exp>
        <pv_name>DEVD:DATA_CTRL:PROCESSING$(CH_NB):CONTROL</pv_name>
      </rule>
      <rule name="Show_trace_min" prop_id="traces[1].visible" out_exp="false">
        <exp bool_exp="pv0&gt;3">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0&lt;4">
          <value>false</value>
        </exp>
        <pv_name>DEVD:DATA_CTRL:PROCESSING$(CH_NB):CONTROL</pv_name>
      </rule>
      <rule name="Show_trace_max" prop_id="traces[2].visible" out_exp="false">
        <exp bool_exp="pv0&gt;3">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0&lt;4">
          <value>false</value>
        </exp>
        <pv_name>DEVD:DATA_CTRL:PROCESSING$(CH_NB):CONTROL</pv_name>
      </rule>
      <rule name="Show_trace_avg" prop_id="traces[3].visible" out_exp="false">
        <exp bool_exp="pv0&gt;3">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0&lt;4">
          <value>false</value>
        </exp>
        <pv_name>DEVD:DATA_CTRL:PROCESSING$(CH_NB):CONTROL</pv_name>
      </rule>
    </rules>
    <x_axis>
      <title>time [ms]</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>65000.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Voltage [kV]</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
