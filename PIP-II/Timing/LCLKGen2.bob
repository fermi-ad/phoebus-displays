  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <file>SetEvent.bob</file>
    <x>290</x>
    <y>840</y>
    <width>460</width>
    <height>70</height>
    <scripts>
      <script file="EmbeddedJs">
        <text><![CDATA[importPackage(Packages.org.csstudio.display.builder.runtime.script);
logger = ScriptUtil.getLogger();

var rawInput = PVUtil.getString(pvs[0]);
var LocalVar2devid = rawInput ? rawInput.trim() : "00"
var displayFile = widget.getPropertyValue("file");

// Update the embedded display's macro map
widget.getPropertyValue("macros").add("devid", LocalVar2devid);

// Force Phoebus to recreate the embedded display
widget.setPropertyValue("file", "");
widget.setPropertyValue("file", displayFile);

print("Updating embedded display: devid=" + LocalVar2devid +", file=" + displayFile);
]]></text>
        <pv_name>loc://devid&lt;VString&gt;("0x00")</pv_name>
      </script>
    </scripts>
  </widget>
