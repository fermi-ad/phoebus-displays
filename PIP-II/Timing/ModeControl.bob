<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>ModeControl</name>
  <macros>
    <system>LACC:BEAM_OPS_</system>
  </macros>
  <width>490</width>
  <height>450</height>
  <background_color>
    <color red="153" green="179" blue="255">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <y>40</y>
    <width>490</width>
    <height>410</height>
    <line_width>2</line_width>
    <line_color>
      <color red="0" green="0" blue="0">
      </color>
    </line_color>
    <transparent>true</transparent>
  </widget>
  <widget type="choice" version="2.0.0">
    <name>Choice Button</name>
    <pv_name>$(system)SYS:sMachineMode</pv_name>
    <x>10</x>
    <y>70</y>
    <width>160</width>
    <height>200</height>
    <horizontal>false</horizontal>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <items>
      <item>Item 1</item>
      <item>Item 2</item>
      <item>Item 3</item>
      <item>Item 4</item>
      <item>Item 5</item>
      <item>Item 6</item>
      <item>Item 7</item>
      <item>Item 8</item>
    </items>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_4</name>
    <text>PIP-II Commissioning Mode Control</text>
    <width>490</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="77" green="77" blue="77">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_width>2</border_width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_5</name>
    <text>Machine Mode Control</text>
    <x>10</x>
    <y>50</y>
    <width>160</width>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="77" green="77" blue="77">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_width>2</border_width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_6</name>
    <text>Beam Mode Control</text>
    <x>180</x>
    <y>50</y>
    <width>160</width>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="77" green="77" blue="77">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_width>2</border_width>
  </widget>
  <widget type="choice" version="2.0.0">
    <name>Choice Button_1</name>
    <pv_name>$(system)SYS:sMM12BeamMode</pv_name>
    <x>180</x>
    <y>70</y>
    <width>160</width>
    <height>125</height>
    <visible>false</visible>
    <horizontal>false</horizontal>
    <rules>
      <rule name="MM12BeamMode" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0=1">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0=2">
          <value>true</value>
        </exp>
        <pv_name>$(system)SYS:sMachineMode</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <items>
      <item>Item 1</item>
      <item>Item 2</item>
      <item>Item 3</item>
      <item>Item 4</item>
      <item>Item 5</item>
    </items>
  </widget>
  <widget type="choice" version="2.0.0">
    <name>Choice Button_2</name>
    <pv_name>$(system)SYS:sMM345BeamMode</pv_name>
    <x>180</x>
    <y>70</y>
    <width>160</width>
    <height>75</height>
    <visible>false</visible>
    <horizontal>false</horizontal>
    <rules>
      <rule name="MM345BeamMode" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0=3">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0=4">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0=5">
          <value>true</value>
        </exp>
        <pv_name>$(system)SYS:sMachineMode</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <items>
      <item>Item 1</item>
      <item>Item 2</item>
      <item>Item 3</item>
    </items>
  </widget>
  <widget type="choice" version="2.0.0">
    <name>Choice Button_3</name>
    <pv_name>$(system)SYS:sMM67BeamMode</pv_name>
    <x>180</x>
    <y>70</y>
    <width>160</width>
    <height>100</height>
    <visible>false</visible>
    <horizontal>false</horizontal>
    <rules>
      <rule name="MM67BeamMode" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0=6">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0=7">
          <value>true</value>
        </exp>
        <pv_name>$(system)SYS:sMachineMode</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <items>
      <item>Item 1</item>
      <item>Item 2</item>
      <item>Item 3</item>
      <item>Item 4</item>
    </items>
  </widget>
  <widget type="byte_monitor" version="2.0.0">
    <name>Byte Monitor</name>
    <pv_name>$(system)SYS:MachineMode</pv_name>
    <x>10</x>
    <y>280</y>
    <width>20</width>
    <height>160</height>
    <bitReverse>true</bitReverse>
    <horizontal>false</horizontal>
    <square>true</square>
    <off_label>Off</off_label>
    <on_label>On</on_label>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="10.0">
      </font>
    </font>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_9</name>
    <text>No Beam</text>
