  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>350</x>
    <y>50</y>
    <width>130</width>
    <height>55</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>Label_27</name>
      <text>Set Pulse Rate</text>
      <width>130</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <foreground_color>
        <color red="255" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="77" green="77" blue="77">
        </color>
      </background_color>
      <transparent>false</transparent>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
      <border_width>2</border_width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_2</name>
      <pv_name>$(system)SYS:sPulseRate</pv_name>
      <y>20</y>
      <width>130</width>
      <precision>1</precision>
      <rules>
        <rule name="Display Setting" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0=2">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0=8">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0=16">
            <value>true</value>
          </exp>
          <pv_name>$(system)SYS:BeamMode</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <enabled>false</enabled>
    </widget>
    <widget type="scrollbar" version="2.0.0">
      <name>Scrollbar_2</name>
      <pv_name>$(system)SYS:sPulseRate</pv_name>
      <y>40</y>
      <width>130</width>
      <height>15</height>
      <rules>
        <rule name="Show Setting" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0=2">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0=8">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0=16">
            <value>true</value>
          </exp>
          <pv_name>$(system)SYS:BeamMode</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <increment>0.5</increment>
      <enabled>false</enabled>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>350</x>
    <y>180</y>
    <width>130</width>
    <height>55</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>Label_7</name>
      <text>Set Pulse Delay</text>
      <width>130</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <foreground_color>
        <color red="255" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="77" green="77" blue="77">
        </color>
      </background_color>
      <transparent>false</transparent>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
      <border_width>2</border_width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry</name>
      <pv_name>$(system)SYS:sPulseDelay</pv_name>
      <y>20</y>
      <width>130</width>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="scrollbar" version="2.0.0">
      <name>Scrollbar</name>
      <pv_name>$(system)SYS:sPulseDelay</pv_name>
      <y>40</y>
      <width>130</width>
      <height>15</height>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>350</x>
    <y>115</y>
    <width>130</width>
    <height>55</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_4</name>
      <pv_name>$(system)SYS:sPulseLength</pv_name>
      <y>20</y>
      <width>130</width>
      <precision>0</precision>
      <rules>
        <rule name="Display Setting" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0&gt;=4">
            <value>true</value>
          </exp>
          <pv_name>$(system)SYS:BeamMode</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <enabled>false</enabled>
    </widget>
    <widget type="scrollbar" version="2.0.0">
      <name>Scrollbar_4</name>
      <pv_name>$(system)SYS:sPulseLength</pv_name>
      <y>40</y>
      <width>130</width>
      <height>15</height>
      <rules>
        <rule name="Show Setting" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0&gt;=4">
            <value>true</value>
          </exp>
          <pv_name>$(system)SYS:BeamMode</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <increment>10.0</increment>
      <enabled>false</enabled>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_8</name>
      <text>Set Pulse Length</text>
      <width>130</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <foreground_color>
        <color red="255" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="77" green="77" blue="77">
        </color>
      </background_color>
      <transparent>false</transparent>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
      <border_width>2</border_width>
    </widget>
  </widget>
</display>
