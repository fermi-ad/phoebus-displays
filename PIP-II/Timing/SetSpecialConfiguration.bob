<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>SetPhysConfiguration</name>
  <macros>
    <system>LACC:LCLK_CTRL_</system>
  </macros>
  <width>795</width>
  <height>70</height>
  <background_color>
    <color name="Button_Background" red="210" green="210" blue="210">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <width>795</width>
    <height>70</height>
    <line_width>1</line_width>
    <line_color>
      <color red="0" green="0" blue="0">
      </color>
    </line_color>
    <transparent>true</transparent>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_118</name>
    <text>Address</text>
    <x>10</x>
    <y>25</y>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry_32</name>
    <pv_name>$(system)GEN:sPhysEventID$(sdevid)</pv_name>
    <x>120</x>
    <y>25</y>
    <format>4</format>
    <precision>1</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_108</name>
    <pv_name>$(system)GEN:PhysEventID$(sdevid)</pv_name>
    <x>120</x>
    <y>5</y>
    <format>4</format>
    <precision>4</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_124</name>
    <text>EventID</text>
    <x>120</x>
    <y>45</y>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry_33</name>
    <pv_name>$(system)GEN:sPhysDelay$(sdevid)</pv_name>
    <x>230</x>
    <y>25</y>
    <format>4</format>
    <precision>1</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_109</name>
    <pv_name>$(system)GEN:PhysDelay$(sdevid)</pv_name>
    <x>230</x>
    <y>5</y>
    <format>4</format>
    <precision>4</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_126</name>
    <text>Event Delay</text>
    <x>230</x>
    <y>45</y>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_127</name>
    <text>$(sdevid)</text>
    <x>10</x>
    <y>5</y>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>670</x>
    <y>5</y>
    <width>115</width>
    <height>35</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button_7</name>
      <pv_name>$(system)$(dev)sPhysEnable$(sdevid)</pv_name>
      <x>25</x>
      <width>90</width>
      <height>20</height>
      <off_label>Set Enable</off_label>
      <off_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </off_color>
      <on_label>Set Disable</on_label>
      <on_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </on_color>
      <show_led>false</show_led>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_125</name>
      <text>Enable</text>
      <x>25</x>
      <y>20</y>
      <width>90</width>
      <height>15</height>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
    </widget>
    <widget type="led" version="2.0.0">
      <name>LED_9</name>
      <pv_name>$(system)GEN:PhysEnable$(sdevid)</pv_name>
      <off_label>0</off_label>
      <on_label>1</on_label>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry_34</name>
    <pv_name>$(system)GEN:sPhysPyldMod$(sdevid)</pv_name>
    <x>340</x>
    <y>25</y>
    <format>4</format>
    <precision>1</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_110</name>
    <pv_name>$(system)GEN:PhysPyldMod$(sdevid)</pv_name>
    <x>340</x>
    <y>5</y>
    <format>4</format>
    <precision>4</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="label" version="2.0.0">
