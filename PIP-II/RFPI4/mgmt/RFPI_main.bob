    </widget>
    <widget type="label" version="2.0.0">
      <name>Sys_title</name>
      <text>Management processor</text>
      <x>10</x>
      <y>6</y>
      <width>200</width>
      <height>24</height>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="14.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>System_plots_button</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>system/system_plots.bob</file>
          <target>tab</target>
        </action>
      </actions>
      <text>Plots</text>
      <x>910</x>
      <y>5</y>
      <width>80</width>
      <height>25</height>
      <tooltip>CPU load and memory plots</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Sys_r1_0</name>
      <text>CPU:</text>
      <x>10</x>
      <y>34</y>
      <width>36</width>
      <height>24</height>
      <font>
        <font family="Source Sans Pro" style="REGULAR" size="12.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Sys_CpuLoad_update</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):CpuLoad_r</pv_name>
      <x>46</x>
      <y>34</y>
      <width>62</width>
      <height>24</height>
      <font>
        <font family="Source Sans Pro" style="REGULAR" size="12.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
      <tooltip>CPU load, last 2 s sample</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Sys_r1_1</name>
      <text>avg:</text>
      <x>116</x>
      <y>34</y>
      <width>30</width>
      <height>24</height>
