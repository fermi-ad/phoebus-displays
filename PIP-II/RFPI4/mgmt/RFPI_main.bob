      <y>20</y>
      <width>160</width>
      <height>150</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>BOT0_display</name>
      <macros>
        <SLOT>BOT0</SLOT>
        <NAME>SLOT BOT0</NAME>
      </macros>
      <file>templates/board.bob</file>
      <x>20</x>
      <y>190</y>
      <width>160</width>
      <height>150</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>BOT1_display</name>
      <macros>
        <SLOT>BOT1</SLOT>
        <NAME>SLOT BOT1</NAME>
      </macros>
      <file>templates/board.bob</file>
      <x>200</x>
      <y>190</y>
      <width>160</width>
      <height>150</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>BOT2_display</name>
      <macros>
        <SLOT>BOT2</SLOT>
        <NAME>SLOT BOT2</NAME>
      </macros>
      <file>templates/board.bob</file>
      <x>380</x>
      <y>190</y>
      <width>160</width>
      <height>150</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>TOP2_display</name>
      <macros>
        <SLOT>TOP2</SLOT>
        <NAME>SLOT TOP2</NAME>
      </macros>
      <file>templates/board.bob</file>
      <x>380</x>
      <y>20</y>
      <width>160</width>
      <height>150</height>
      <resize>2</resize>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Main_Group</name>
    <x>140</x>
    <y>280</y>
    <width>200</width>
    <height>360</height>
    <style>3</style>
    <widget type="rectangle" version="2.0.0">
      <name>Main_Rectangle</name>
      <width>200</width>
      <height>360</height>
      <line_width>2</line_width>
      <line_color>
        <color name="GROUP-BORDER" red="150" green="155" blue="151">
        </color>
      </line_color>
      <background_color>
        <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
        </color>
      </background_color>
      <corner_width>10</corner_width>
      <corner_height>10</corner_height>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>INTER_display</name>
      <macros>
        <SLOT>INTER</SLOT>
        <NAME>INTERFACE</NAME>
      </macros>
      <file>templates/board.bob</file>
      <x>20</x>
      <y>190</y>
      <width>160</width>
      <height>150</height>
      <resize>2</resize>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>MAIN_display</name>
      <macros>
        <SLOT>MAIN</SLOT>
        <NAME>MAIN</NAME>
      </macros>
      <file>templates/board.bob</file>
      <x>20</x>
      <y>20</y>
      <width>160</width>
      <height>150</height>
      <resize>2</resize>
    </widget>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Versions Button</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>versions/versions.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Versions</text>
    <x>490</x>
    <y>230</y>
    <width>80</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Deamon_Group</name>
    <x>290</x>
    <y>190</y>
    <width>180</width>
    <height>70</height>
    <style>3</style>
    <widget type="rectangle" version="2.0.0">
      <name>Deamon_Rectangle</name>
      <width>180</width>
      <height>70</height>
      <line_width>2</line_width>
      <line_color>
        <color name="GROUP-BORDER" red="150" green="155" blue="151">
        </color>
      </line_color>
      <background_color>
        <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
        </color>
      </background_color>
      <corner_width>10</corner_width>
      <corner_height>10</corner_height>
    </widget>
    <widget type="led" version="2.0.0">
      <name>Deamon_LED</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):DeamonConnection_r</pv_name>
      <x>140</x>
      <y>20</y>
      <width>30</width>
      <height>30</height>
      <off_color>
        <color name="ERROR" red="252" green="13" blue="27">
        </color>
      </off_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Deamon_label</name>
      <text>Deamon Status:</text>
      <y>20</y>
      <width>130</width>
      <height>30</height>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </font>
      <horizontal_alignment>2</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>History_Group</name>
    <x>20</x>
    <y>190</y>
    <width>250</width>
    <height>70</height>
    <style>3</style>
    <widget type="rectangle" version="2.0.0">
      <name>History_Rectangle</name>
      <width>250</width>
      <height>70</height>
      <line_width>2</line_width>
      <line_color>
        <color name="GROUP-BORDER" red="150" green="155" blue="151">
        </color>
      </line_color>
      <background_color>
        <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
        </color>
      </background_color>
      <corner_width>10</corner_width>
      <corner_height>10</corner_height>
    </widget>
    <widget type="label" version="2.0.0">
      <name>History_label</name>
      <text>System History:</text>
      <y>20</y>
      <width>130</width>
      <height>30</height>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </font>
      <horizontal_alignment>2</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>History_button</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>history/history.bob</file>
          <target>tab</target>
        </action>
      </actions>
      <text>History</text>
      <x>150</x>
      <y>20</y>
      <width>80</width>
      <tooltip>$(actions)</tooltip>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>LastFault_Group</name>
    <x>590</x>
    <y>190</y>
    <width>430</width>
    <height>70</height>
    <style>3</style>
    <widget type="rectangle" version="2.0.0">
      <name>LastFault_Rectangle</name>
      <width>430</width>
      <height>70</height>
      <line_width>2</line_width>
      <line_color>
        <color name="GROUP-BORDER" red="150" green="155" blue="151">
        </color>
      </line_color>
      <background_color>
        <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
        </color>
      </background_color>
      <corner_width>10</corner_width>
      <corner_height>10</corner_height>
    </widget>
    <widget type="label" version="2.0.0">
      <name>LastFault_label</name>
      <text>Last fault:</text>
      <x>10</x>
      <y>5</y>
      <width>90</width>
      <height>28</height>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>FaultSource_update</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):FaultSource_r</pv_name>
      <x>105</x>
      <y>5</y>
      <width>315</width>
      <height>28</height>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
      <tooltip>Card position that caused the last FAULT / EMERGENCY ("system" = SoM / Kria / sequencer). Red while the fault is latched.</tooltip>
      <rules>
        <rule name="Red while latched" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="pv0==7">
            <value>
              <color name="MAJOR" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(acc):$(sys)_$(group)_$(num_gen):SystemStatus_r</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>FaultReason_update</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):FaultReason_r</pv_name>
      <x>10</x>
      <y>36</y>
      <width>410</width>
      <height>28</height>
      <font>
        <font family="Source Sans Pro" style="REGULAR" size="12.0">
        </font>
      </font>
      <format>6</format>
      <vertical_alignment>1</vertical_alignment>
      <tooltip>$(pv_value)</tooltip>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>System_Health_Group</name>
    <x>20</x>
    <y>655</y>
    <width>1000</width>
    <height>122</height>
    <style>3</style>
    <widget type="rectangle" version="2.0.0">
      <name>System_Health_Rectangle</name>
      <width>1000</width>
