<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>RFPI Management Main</name>
  <macros>
    <num>MAIN</num>
    <num_gen>system</num_gen>
  </macros>
  <width>1040</width>
  <height>790</height>
  <widget type="rectangle" version="2.0.0">
    <name>Titlebar</name>
    <width>1040</width>
    <height>50</height>
    <line_width>0</line_width>
    <background_color>
      <color name="PRIMARY-HEADER-BACKGROUND" red="151" green="188" blue="202">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>RFPI Management</text>
    <x>20</x>
    <width>300</width>
    <height>50</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color name="HEADER-TEXT" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="group" version="3.0.0">
    <name>System_group</name>
    <x>20</x>
    <y>70</y>
    <width>1000</width>
    <height>100</height>
    <style>3</style>
    <background_color>
      <color name="BACKGROUND" red="220" green="225" blue="221">
      </color>
    </background_color>
    <widget type="rectangle" version="2.0.0">
      <name>System_background</name>
      <width>1000</width>
      <height>100</height>
      <line_width>2</line_width>
      <line_color>
        <color name="GROUP-BORDER" red="150" green="155" blue="151">
        </color>
      </line_color>
      <background_color>
        <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
        </color>
      </background_color>
      <corner_width>10</corner_width>
      <corner_height>10</corner_height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>On_button</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):PowerSystem_s</pv_name>
      <text>ON</text>
      <x>715</x>
      <y>50</y>
      <width>55</width>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </font>
      <tooltip>$(actions)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Off_button</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>0</value>
        </action>
      </actions>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):PowerSystem_s</pv_name>
      <text>OFF</text>
      <x>775</x>
      <y>50</y>
      <width>55</width>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </font>
      <tooltip>$(actions)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>ClearFault_button</name>
      <actions>
        <action type="write_pv">
          <description>Clear fault</description>
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):ClearFault_s</pv_name>
      <text>Clear fault</text>
      <x>560</x>
      <y>50</y>
      <width>100</width>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="14.0">
        </font>
      </font>
      <tooltip>Acknowledge a latched FAULT / EMERGENCY: system -&gt; DOWN, then power-up is possible again. Check the cause first (History). Result in the message field.</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <confirm_dialog>true</confirm_dialog>
      <confirm_message>Acknowledge the latched fault? The system goes to DOWN; power-up is possible afterwards.</confirm_message>
      <rules>
        <rule name="Highlight in Error" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0==7">
            <value>
              <color name="MAJOR" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(acc):$(sys)_$(group)_$(num_gen):SystemStatus_r</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Status_update</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):SystemStatusStr_r</pv_name>
      <x>370</x>
      <y>50</y>
      <width>180</width>
      <height>30</height>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Status_title</name>
      <text>System Overall</text>
      <width>1000</width>
      <height>40</height>
      <font>
        <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
        </font>
      </font>
      <background_color>
        <color name="RED-BORDER" red="150" green="8" blue="16">
        </color>
      </background_color>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Power_label</name>
      <text>Power:</text>
      <x>665</x>
      <y>50</y>
      <width>45</width>
      <height>30</height>
      <horizontal_alignment>2</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="multi_state_led" version="2.0.0">
      <name>Status_LED</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):SystemStatus_r</pv_name>
      <x>10</x>
      <y>50</y>
      <width>30</width>
      <height>30</height>
      <states>
        <state>
          <value>2</value>
          <label></label>
          <color>
            <color name="ERROR" red="252" green="13" blue="27">
            </color>
          </color>
        </state>
        <state>
          <value>3</value>
          <label></label>
          <color>
            <color name="On" red="70" green="255" blue="70">
            </color>
          </color>
        </state>
        <state>
          <value>4</value>
          <label></label>
          <color>
            <color name="ATTENTION" red="252" green="242" blue="17">
            </color>
          </color>
        </state>
        <state>
          <value>5</value>
          <label></label>
          <color>
            <color name="ATTENTION" red="252" green="242" blue="17">
            </color>
          </color>
        </state>
        <state>
          <value>7</value>
          <label></label>
          <color>
            <color name="ERROR" red="252" green="13" blue="27">
            </color>
          </color>
        </state>
        <state>
          <value>6</value>
          <label></label>
          <color>
            <color name="ERROR" red="252" green="13" blue="27">
            </color>
          </color>
        </state>
        <state>
          <value>0</value>
          <label></label>
          <color>
            <color name="ERROR" red="252" green="13" blue="27">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label></label>
          <color>
            <color name="ERROR" red="252" green="13" blue="27">
            </color>
          </color>
        </state>
      </states>
      <fallback_label></fallback_label>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>PowerStatus_update</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):PowerSystemMsg_r</pv_name>
      <x>840</x>
      <y>50</y>
      <width>150</width>
      <height>30</height>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>SystemStatus_update</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):SystemStatus_r</pv_name>
      <x>50</x>
      <y>50</y>
      <width>100</width>
      <height>30</height>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Timestamp_update</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num_gen):SystemEventTime_r</pv_name>
      <x>160</x>
      <y>50</y>
      <width>200</width>
      <height>30</height>
      <format>6</format>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Slots_Group</name>
    <x>360</x>
    <y>280</y>
    <width>560</width>
    <height>360</height>
    <style>3</style>
