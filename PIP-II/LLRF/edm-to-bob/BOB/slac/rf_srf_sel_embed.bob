  <widget type="action_button" version="3.0.0">
    <name>EDM relatedDisplayClass</name>
    <actions>
      <action type="open_display">
        <file>rf_srf_wf_signal.bob</file>
        <macros>
          <SIG>CAV</SIG>
          <SIGNAL>Cavity Probe</SIGNAL>
          <EGU></EGU>
        </macros>
        <target>tab</target>
        <description>Cavity Probe</description>
      </action>
      <action type="open_display">
        <file>rf_srf_wf_signal.bob</file>
        <macros>
          <SIG>FWD</SIG>
          <SIGNAL>Forward</SIGNAL>
          <EGU>sqrt(W)</EGU>
        </macros>
        <target>tab</target>
        <description>Forward</description>
      </action>
      <action type="open_display">
        <file>rf_srf_wf_signal.bob</file>
        <macros>
          <SIG>REV</SIG>
          <SIGNAL>Reverse</SIGNAL>
          <EGU>sqrt(W)</EGU>
        </macros>
        <target>tab</target>
        <description>Reverse</description>
      </action>
      <action type="open_display">
        <file>rf_srf_wf_signal_autoscale.bob</file>
        <macros>
          <SIG>DRV</SIG>
          <SIGNAL>Drive</SIGNAL>
          <EGU>sqrt(W)</EGU>
        </macros>
        <target>tab</target>
        <description>Drive (Loop)</description>
      </action>
      <action type="open_display">
        <file>rf_srf_wf_signal_autoscale.bob</file>
        <macros>
          <SIG>DAC</SIG>
          <SIGNAL>DAC</SIGNAL>
          <EGU>-</EGU>
        </macros>
        <target>tab</target>
        <description>DAC</description>
      </action>
      <action type="open_display">
        <file>rf_srf_wf_df.bob</file>
        <macros>
          <SIG>DF</SIG>
          <SIGNAL>Detune</SIGNAL>
          <EGU>Hz</EGU>
        </macros>
        <target>tab</target>
        <description>Detune</description>
      </action>
    </actions>
    <text>More Cavity $(C)</text>
    <x>1000</x>
    <y>804</y>
    <width>152</width>
    <height>24</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
