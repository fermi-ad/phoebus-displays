        <value>1</value>
      </action>
    </actions>
    <pv_name>$(CM)$(C)0:STEP:PUSH_NSTEPS_COLD.PROC</pv_name>
    <text>Push Signed to Cold</text>
    <x>232</x>
    <y>860</y>
    <width>136</width>
