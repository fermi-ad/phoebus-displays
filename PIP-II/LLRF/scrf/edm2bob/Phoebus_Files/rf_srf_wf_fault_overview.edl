}
nPv {
  0 "$(CM)$(C)0:CAV:FLTNORD"
  1 "$(CM)$(C)0:FWD:FLTNORD"
  2 "$(CM)$(C)0:REV:FLTNORD"
  3 "$(CM)$(C)0:CAV:FLTNORD"
}
lineThickness {
  0 3
}
lineStyle {
  0 "dash"
}
plotUpdateMode {
  0 "xOrY"
  1 "xOrY"
  2 "xOrY"
  3 "xOrY"
}
opMode {
  0 "plot"
  1 "plot"
  2 "plot"
  3 "plot"
}
useY2Axis {
  1 1
  2 1
}
xSigned {
  0 1
  1 1
  2 1
  3 1
}
ySigned {
