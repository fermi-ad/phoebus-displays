# (Shell Command)
object shellCmdClass
beginObjectProperties
major 4
minor 3
release 0
x 748
y 400
w 52
h 24
fgColor index 14
bgColor index 3
topShadowColor index 1
botShadowColor index 11
font "helvetica-medium-r-12.0"
buttonLabel "Log..."
multipleInstances
numCmds 1
command {
  0 "xterm -hold -sb -rightbar -sl 10000 -geometry 130x30 -T \"LLRF Rack Frequency Shift Log File\" -e rfViewLogRecent.bash $PHYSICS_DATA/rf_lcls2/df_scan_rack/$(CM)00 $(R) *SHIFT*.log 0 &"
}
endObjectProperties

