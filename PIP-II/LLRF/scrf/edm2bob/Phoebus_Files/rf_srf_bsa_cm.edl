# (Static Text)
object activeXTextClass
beginObjectProperties
major 4
minor 1
release 1
x 24
y 76
w 352
h 236
font "helvetica-medium-r-12.0"
fgColor index 14
bgColor index 3
useDisplayBg
value {
  "This BSA data is read out slowly and is intended to capture"
  "snapshots of a single transmission from LLRF to BSA. "
  "If PID Before equals PID After, then it is a synchronous data set."
  "(That PID is the lower 32 bits of the global timing PID.)"
  ""
  "Synchronous data sets are stored in these PVs:"
  ""
  "$(CM)00:PRCA:BSADIAG_DATA"
  "$(CM)00:PRCB:BSADIAG_DATA"
  ""
  "They are 10-element arrays with these contents:"
  ""
  "If you prefer to use scalars and/or do not require"
  "synchronous sets, you can also use the PVs below."
}
endObjectProperties

