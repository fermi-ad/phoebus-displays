# (Embedded Window)
object activePipClass
beginObjectProperties
major 4
minor 1
release 0
x 8
y 52
w 500
h 280
fgColor index 14
bgColor index 4
topShadowColor index 1
botShadowColor index 11
displaySource "menu"
filePv "LOC\\$(!W)menuPV=i:0"
sizeOfs 5
numDsps 1
displayFileName {
  0 "rf_srf_intlk_lo_chas_embed"
}
symbols {
  0 "CM=$(CM),C=$(C),RFS=1A,CHAS=$(CM)00:RFS1A,R=A,ID=$(ID),CH=$(CH),QFTYPE=rfs"
}
replaceSymbols {
  0 1
}
noScroll
endObjectProperties

