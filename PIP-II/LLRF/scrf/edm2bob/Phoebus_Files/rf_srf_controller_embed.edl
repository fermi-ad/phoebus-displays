  1 2
  2 2
}
plotUpdateMode {
  0 "xOrY"
  1 "xOrY"
  2 "xOrY"
}
opMode {
  0 "plot"
  1 "plot"
  2 "plot"
}
xSigned {
  0 1
}
ySigned {
  0 1
}
plotColor {
  0 index 25
  1 index 32
  2 index 32
}
endObjectProperties

