# (Shell Command)
object shellCmdClass
beginObjectProperties
major 4
minor 3
release 0
x 480
y 144
w 52
h 24
fgColor index 14
bgColor index 3
topShadowColor index 1
botShadowColor index 11
font "helvetica-medium-r-12.0"
buttonLabel "File..."
multipleInstances
numCmds 1
command {
  0 "xterm -hold -sb -rightbar -sl 10000 -geometry 130x30 -T \"LLRF Cavity ADC Data\" -e rfViewLogRecent.bash $PHYSICS_DATA/rf_lcls2/adc_data/$(CM)20 $(CM)20 raw_z_00 0 &"
}
endObjectProperties

