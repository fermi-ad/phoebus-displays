# (Static Text)
object activeXTextClass
beginObjectProperties
major 4
minor 1
release 1
x 12
y 24
w 361
h 196
font "helvetica-medium-r-12.0"
fgColor index 14
bgColor index 3
useDisplayBg
value {
  "1. Is there a red box on the RF Controller tab? "
  "     Re-run Pulsed SEL Cal"
  "2. WF decimation should be 255 "
  "     (shortcut at bottom of unit test EDM)"
  "3. Check the detune in SELA at 10-16MV with fb in manual and "
  "     offset=0. Turn fb back on after zeroing."
  "4. Check amp & phas fbck gains: -2000/-200 or -200/-20 are "
  "     good places to start."
  "5. Check Reactive Power Fraction - needs to be >0 for SELAP"
  "6. Check Amp/Phas Diag page for overrange"
  "7. Check SEL phase offset - minimize FWD power in SELA or "
  "     straightent the cheeto in SELAP"
  "8. If amplitude isn't regulating, try re-calibrating the SSA"
  "     and re-doing cavity cdharacterization."
}
autoSize
endObjectProperties

