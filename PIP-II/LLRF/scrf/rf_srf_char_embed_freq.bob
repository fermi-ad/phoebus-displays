        <rule name="EDM visibility" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0&gt;=2.0 &amp;&amp; pv0&lt;3.0">
            <value>true</value>
          </exp>
          <exp bool_exp="true">
            <value>false</value>
          </exp>
          <pv_name>$(CM)$(C)0:PZT:INTEG_AT_LIM</pv_name>
        </rule>
      </rules>
    </widget>
