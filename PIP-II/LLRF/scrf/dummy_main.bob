<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>LLRF Launcher</name>
  <width>360</width>
  <height>180</height>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Open CMTF LLRF</description>
        <file>rf_srf_cavity_main.bob</file>
        <macros>
          <CM>PIP2IT:PHB650:H1</CM>
          <C>1</C>
          <RFS>1A</RFS>
          <R>A</R>
          <CH>1</CH>
          <ID>2</ID>
          <SELCHAR>0</SELCHAR>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <x>10</x>
    <y>10</y>
    <width>160</width>
    <height>40</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <description>Open VXI LLRF</description>
        <file>rf_srf_cavity_main_fnal.bob</file>
        <macros>
          <CM>VXI:TEST_LLRF_C</CM>
          <C>1</C>
          <RFS>1A</RFS>
          <R>A</R>
          <CH>1</CH>
          <ID>2</ID>
          <SELCHAR>0</SELCHAR>
          <SCRIPTDIR>/usr/local/epics/iocTops/sclLLRF/fnalRfApp/script</SCRIPTDIR>
          <LOGDIR>/var/log/ioc/sclLLRF/rf_vxi</LOGDIR>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <x>10</x>
    <y>70</y>
    <width>160</width>
    <height>40</height>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="open_display">
        <description>Open Marble Monitor</description>
        <file>../MarbleMonitor.bob</file>
        <macros>
          <P>VXI:</P>
          <R>TEST_LLRF_SYS:</R>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <x>190</x>
    <y>70</y>
    <width>160</width>
    <height>40</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="open_display">
        <description>Open STC LLRF</description>
        <file>rf_srf_cavity_main_fnal.bob</file>
        <macros>
          <CM>STC:TEST_LLRF_C</CM>
          <C>1</C>
          <RFS>1A</RFS>
          <R>A</R>
          <CH>1</CH>
          <ID>2</ID>
          <SELCHAR>0</SELCHAR>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <x>10</x>
    <y>130</y>
    <width>160</width>
    <height>40</height>
    <tooltip>$(actions)</tooltip>
  </widget>
</display>
