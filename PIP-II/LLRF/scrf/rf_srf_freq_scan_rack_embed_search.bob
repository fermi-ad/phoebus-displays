    <name>EDM shellCmdClass</name>
    <actions>
      <action type="command">
        <command>xterm -hold -sb -rightbar -sl 10000 -geometry 130x30 -T "LLRF Rack Frequency Shift Log File" -e rfViewLogRecent.bash $PHYSICS_DATA/rf_lcls2/df_scan_rack/$(CM)00 $(R) *SEARCH*.log</command>
        <description>Execute Command</description>
      </action>
    </actions>
    <text>Log</text>
    <x>736</x>
    <y>328</y>
    <width>52</width>
    <height>24</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0">
