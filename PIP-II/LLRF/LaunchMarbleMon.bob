<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Open MarbleMonitor</name>
  <width>180</width>
  <height>60</height>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Open MarbleMon</description>
        <file>MarbleMon.bob</file>
        <macros>
          <P>VXI:</P>
          <R>TEST_LLRF_SYS</R>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <x>10</x>
    <y>10</y>
    <width>160</width>
    <height>40</height>
    <tooltip>$(actions)</tooltip>
  </widget>
</display>
