<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Mass Flow Test</name>
  <macros>
    <complex>CMTS</complex>
    <sys>TEST</sys>
    <group>CRYO</group>
    <system>$(complex):$(sys)_$(group)_</system>
  </macros>
  <width>1000</width>
  <height>1100</height>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_1</name>
    <y>590</y>
    <width>1000</width>
    <height>505</height>
    <line_width>2</line_width>
    <transparent>true</transparent>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <y>50</y>
    <width>1000</width>
    <height>505</height>
    <line_width>2</line_width>
    <transparent>true</transparent>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Mass Flow Test</text>
    <width>1000</width>
    <height>30</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <background_color>
      <color red="128" green="128" blue="0">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="stripchart" version="2.1.0">
    <name>Mass Flow Comparison</name>
    <x>5</x>
    <y>240</y>
    <width>990</width>
    <height>310</height>
    <background_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </background_color>
    <title>HTTS Mass Flow Comparison</title>
    <show_toolbar>false</show_toolbar>
    <show_legend>true</show_legend>
    <start>10 minute</start>
    <y_axes>
      <y_axis>
        <title>Mass Flow (g/s)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>50.0</maximum>
        <show_grid>true</show_grid>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>C:8FTE2</name>
        <y_pv>$(system)C8FTE2:GHeFlow</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>Computed Flow</name>
        <y_pv>$(system)HTTS:MassFlow</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="255" green="0" blue="0">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="stripchart" version="2.1.0">
    <name>Mass Flow Comparison_1</name>
    <y>780</y>
    <width>990</width>
    <height>310</height>
    <background_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </background_color>
    <title>LTTS Mass Flow Comparison</title>
    <show_toolbar>false</show_toolbar>
    <show_legend>true</show_legend>
    <start>10 minute</start>
    <y_axes>
      <y_axis>
        <title>Mass Flow (g/s)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>50.0</maximum>
        <show_grid>true</show_grid>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>C:8FTC2</name>
        <y_pv>$(system)C8FTC2:GHeFlow</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>Computed Flow</name>
        <y_pv>$(system)LTTS:MassFlow</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="255" green="0" blue="0">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
