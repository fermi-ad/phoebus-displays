    <widget type="rectangle" version="2.0.0">
      <name>Rectangle</name>
      <x>100</x>
      <y>50</y>
      <width>190</width>
      <height>30</height>
      <line_color>
        <color name="ERROR" red="252" green="13" blue="27">
        </color>
      </line_color>
      <transparent>true</transparent>
      <rules>
        <rule name="Blink when wrong board" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0==0 &amp;&amp; pv1==1">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0 == 1">
            <value>false</value>
          </exp>
          <exp bool_exp="pv0==0 &amp;&amp; pv1==0">
            <value>false</value>
          </exp>
          <pv_name>$(acc):$(sys)_$(group)_$(num):TypeOK_r</pv_name>
          <pv_name>sim://ramp(0,1,0.5)</pv_name>
        </rule>
      </rules>
    </widget>
