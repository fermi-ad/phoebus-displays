    <widget type="multi_state_led" version="2.0.0">
      <name>Status_LED</name>
      <pv_name>$(acc):$(sys)_$(group)_$(num):Status_r</pv_name>
      <x>20</x>
      <y>50</y>
      <width>30</width>
      <height>30</height>
      <states>
        <state>
          <value>0</value>
          <label></label>
          <color>
            <color name="On" red="70" green="255" blue="70">
            </color>
          </color>
        </state>
        <state>
