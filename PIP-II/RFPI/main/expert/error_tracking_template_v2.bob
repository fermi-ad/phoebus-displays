<?xml version="1.0" encoding="UTF-8"?>
<!--Saved on 2025-04-25 09:59:18 by kacpe-->
<display version="2.0.0">
  <name>Display</name>
  <width>630</width>
  <height>30</height>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <width>630</width>
    <height>30</height>
    <line_color>
      <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
      </color>
    </line_color>
    <background_color>
      <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
      </color>
    </background_color>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LatchedStatus_LED</name>
    <pv_name>$(acc):$(sys)_$(group)_$(num):EventSeq$(EVENT)LatchStatus_r</pv_name>
    <x>340</x>
    <width>30</width>
    <height>30</height>
    <off_color>
      <color name="ON" red="70" green="255" blue="70">
      </color>
    </off_color>
    <on_color>
      <color name="MAJOR" red="252" green="13" blue="27">
      </color>
    </on_color>
  </widget>
  <widget type="led" version="2.0.0">
    <name>CurrentStatus_LED</name>
    <pv_name>$(acc):$(sys)_$(group)_$(num):EventSeq$(EVENT)CurrentStatus_r</pv_name>
    <x>280</x>
    <width>30</width>
    <height>30</height>
    <off_color>
      <color name="ON" red="70" green="255" blue="70">
      </color>
    </off_color>
    <on_color>
      <color name="MAJOR" red="252" green="13" blue="27">
      </color>
    </on_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Timestamp_update</name>
    <pv_name>$(acc):$(sys)_$(group)_$(num):EventSeq$(EVENT)Timestamp_r</pv_name>
    <x>460</x>
    <width>170</width>
    <height>30</height>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="led" version="2.0.0">
    <name>Mask_LED</name>
    <pv_name>$(acc):$(sys)_$(group)_$(num):EventSeq$(EVENT)Masking_r</pv_name>
    <x>400</x>
    <width>30</width>
    <height>30</height>
    <off_color>
      <color name="MINOR" red="252" green="242" blue="17">
      </color>
    </off_color>
    <on_color>
      <color name="GROUP-BACKGROUND" red="200" green="205" blue="201">
      </color>
    </on_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Name_update</name>
    <pv_name>$(acc):$(sys)_$(group)_$(num):EventSeq$(EVENT)Name_r</pv_name>
    <x>50</x>
    <width>200</width>
    <height>30</height>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>$(EVENT).</text>
    <width>40</width>
    <height>30</height>
    <horizontal_alignment>2</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
</display>
