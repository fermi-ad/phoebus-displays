          <macros>
            <CHANNEL_NAME>MPS Permit C$(CAVITY)</CHANNEL_NAME>
            <num>MPS_PERM_C$(CAVITY)</num>
          </macros>
          <target>tab</target>
          <description>Open Display</description>
        </action>
      </actions>
      <text>MPS</text>
      <x>70</x>
      <y>170</y>
      <width>210</width>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="led" version="2.0.0">
      <name>MPSPermit_LED</name>
      <pv_name>$(acc):$(sys)_$(group)_MPS_PERM_C$(CAVITY):Status_r</pv_name>
      <x>30</x>
      <y>170</y>
      <width>30</width>
      <height>30</height>
      <off_color>
        <color name="MAJOR" red="252" green="13" blue="27">
        </color>
      </off_color>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>ResetPermits_button</name>
      <actions execute_as_one="true">
        <action type="write_pv">
          <pv_name>$(acc):$(sys)_$(group)_LLRF_PERM_C$(CAVITY):Reset_s</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
      </actions>
      <text>Reset</text>
      <x>120</x>
      <y>220</y>
      <width>110</width>
      <height>40</height>
      <font>
        <font family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </font>
      <tooltip>$(actions)</tooltip>
    </widget>
  </widget>
</display>
