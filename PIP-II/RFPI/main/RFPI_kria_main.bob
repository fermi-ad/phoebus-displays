    <widget type="action_button" version="3.0.0">
      <name>ResetCommon_button</name>
      <actions execute_as_one="true">
        <action type="write_pv">
          <pv_name>$(acc):$(sys)_$(group)_NIRP1:Rst_s</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(acc):$(sys)_$(group)_NIRP2:Rst_s</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(acc):$(sys)_$(group)_NIRP3:Rst_s</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
