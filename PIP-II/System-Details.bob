<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>System-Status-Display</name>
  <width>650</width>
  <widget type="label" version="2.0.0">
    <name>Main-Topic-Label</name>
    <text>System Information</text>
    <width>650</width>
    <height>35</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <background_color>
      <color name="Attention" red="255" green="160" blue="0">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Hard-1-Group</name>
    <x>12</x>
    <y>480</y>
    <width>509</width>
    <height>35</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>HD-1-Use-Label</name>
      <class>Label</class>
      <text>Hard Disk 1 Usage (%)</text>
      <y>8</y>
      <width>164</width>
      <height>18</height>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="16.0">
        </font>
      </font>
      <auto_size>true</auto_size>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Ram-Tot-TU_3</name>
      <pv_name>=((`PIP2:TIME_CTRL_WRSWITCH:2_1001_40_calc_hdd1_size` - `PIP2:TIME_CTRL_WRSWITCH:2_1001_41_hdd1_free`)/`PIP2:TIME_CTRL_WRSWITCH:2_1001_40_calc_hdd1_size`)*100</pv_name>
      <x>171</x>
      <y>2</y>
      <height>29</height>
      <precision>2</precision>
      <show_units>false</show_units>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="progressbar" version="2.0.0">
      <name>HD-1-Progress-Bar</name>
      <pv_name>=((`PIP2:TIME_CTRL_WRSWITCH:2_1001_40_calc_hdd1_size` - `PIP2:TIME_CTRL_WRSWITCH:2_1001_41_hdd1_free`)/`PIP2:TIME_CTRL_WRSWITCH:2_1001_40_calc_hdd1_size`)*100</pv_name>
      <x>279</x>
      <width>230</width>
      <height>35</height>
      <fill_color>
        <color name="acorn.Text.White" red="255" green="255" blue="255">
        </color>
      </fill_color>
      <rules>
        <rule name="Progess-Bar-Color" prop_id="fill_color" out_exp="false">
          <exp bool_exp="((pv0 - pv1)/pv0)*100 &lt; 50">
            <value>
              <color red="60" green="255" blue="60">
              </color>
            </value>
          </exp>
          <exp bool_exp="((pv0 - pv1)/pv0)*100 &gt;= 50 &amp;&amp; ((pv0 - pv1)/pv0)*100 &lt;= 75">
            <value>
              <color name="Attention" red="255" green="160" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="((pv0 - pv1)/pv0)*100 &gt; 75">
            <value>
              <color name="acorn.Red" red="229" green="56" blue="35">
              </color>
            </value>
          </exp>
          <pv_name>PIP2:TIME_CTRL_WRSWITCH:2_1001_40_calc_hdd1_size</pv_name>
          <pv_name>PIP2:TIME_CTRL_WRSWITCH:2_1001_41_calc_hdd1_free</pv_name>
        </rule>
      </rules>
      <tooltip>$(pv_value)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
  </widget>
