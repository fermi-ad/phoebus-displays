      <x>255</x>
      <width>230</width>
      <height>35</height>
      <fill_color>
        <color name="acorn.Text.White" red="255" green="255" blue="255">
        </color>
      </fill_color>
      <rules>
        <rule name="Progess-Bar-Color" prop_id="fill_color" out_exp="false">
