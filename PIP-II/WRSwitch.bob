    <name>Progess-Bar-Group</name>
    <x>296</x>
    <y>597</y>
    <width>299</width>
    <height>82</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>RAM-Use-Label</name>
      <class>Label</class>
      <text>RAM Usage (%)</text>
      <x>1</x>
      <width>116</width>
      <height>19</height>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="16.0">
        </font>
      </font>
      <auto_size>true</auto_size>
    </widget>
    <widget type="progressbar" version="2.0.0">
      <name>RAM-Progress-Bar</name>
      <pv_name>=((`PIP2:TIME_CTRL_WRSWITCH:2_1001_20_calc_ram_total` - `PIP2:TIME_CTRL_WRSWITCH:2_1001_21_calc_ram_free`)/`PIP2:TIME_CTRL_WRSWITCH:2_1001_20_calc_ram_total`)*100</pv_name>
      <x>129</x>
      <y>1</y>
      <width>170</width>
      <fill_color>
        <color name="acorn.Text.White" red="255" green="255" blue="255">
        </color>
      </fill_color>
      <rules>
        <rule name="Progess-Bar-Color" prop_id="fill_color" out_exp="false">
          <exp bool_exp="((pv0 - pv1)/pv0)*100 &lt; 50">
            <value>
              <color red="60" green="255" blue="60">
              </color>
            </value>
          </exp>
          <exp bool_exp="((pv0 - pv1)/pv0)*100 &gt;= 50 &amp;&amp; ((pv0 - pv1)/pv0)*100 &lt;= 75">
            <value>
              <color name="Attention" red="255" green="160" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="((pv0 - pv1)/pv0)*100 &gt; 75">
            <value>
              <color name="acorn.Red" red="229" green="56" blue="35">
              </color>
            </value>
          </exp>
          <pv_name>PIP2:TIME_CTRL_WRSWITCH:2_1001_20_calc_ram_total</pv_name>
          <pv_name>PIP2:TIME_CTRL_WRSWITCH:2_1001_21_calc_ram_free</pv_name>
        </rule>
      </rules>
      <tooltip>$(pv_value)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
