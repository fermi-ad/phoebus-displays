  <widget type="thermometer" version="2.0.0">
    <name>Thermometer</name>
    <pv_name>PIP2:TIME_CTRL_WRSWITCH:2_1001_60_calc_fpga_temp</pv_name>
    <x>209</x>
    <y>597</y>
    <width>50</width>
    <height>100</height>
    <fill_color>
      <color name="cryo.return.2K" red="0" green="0" blue="255">
      </color>
    </fill_color>
    <rules>
      <rule name="Fill-Color-rule" prop_id="fill_color" out_exp="false">
        <exp bool_exp="pv0 &lt; 50">
          <value>
            <color red="60" green="255" blue="60">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0 &gt;= 50 &amp;&amp; pv0 &lt;= 75">
          <value>
            <color name="cryo.return.2K" red="0" green="0" blue="255">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0 &gt; 75">
          <value>
            <color name="acorn.Red" red="229" green="56" blue="35">
            </color>
          </value>
        </exp>
        <pv_name>PIP2:TIME_CTRL_WRSWITCH:2_1001_60_calc_fpga_temp</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <limits_from_pv>false</limits_from_pv>
    <maximum>120.0</maximum>
  </widget>
