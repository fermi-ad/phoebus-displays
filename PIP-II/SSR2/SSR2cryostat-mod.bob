  <widget type="ellipse" version="2.0.0">
    <name>Ellipse</name>
    <x>913</x>
    <y>651</y>
    <width>20</width>
    <height>20</height>
    <line_width>1</line_width>
    <line_color>
      <color red="0" green="0" blue="0">
      </color>
    </line_color>
    <background_color>
      <color name="Off" red="60" green="100" blue="60">
      </color>
    </background_color>
    <rules>
      <rule name="Pump On" prop_id="background_color" out_exp="false">
        <exp bool_exp="(pv0&lt;24.0) &amp;&amp; (pv1==1)">
          <value>
            <color name="On" red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(system)PT041:Pressure</pv_name>
        <pv_name>$(system)PV604H:VLVstat</pv_name>
      </rule>
      <rule name="Pump Off" prop_id="background_color" out_exp="false">
        <exp bool_exp="(pv0&gt;=14.5) &amp;&amp; (pv1==0)">
          <value>
            <color name="Off" red="60" green="100" blue="60">
            </color>
          </value>
        </exp>
        <pv_name>$(system)PT042:Pressure</pv_name>
        <pv_name>$(system)PV604H:VLVstat</pv_name>
      </rule>
    </rules>
  </widget>
