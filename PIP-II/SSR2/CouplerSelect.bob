  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_3</name>
    <pv_name>$(P)PLC_PLC111:sB23032</pv_name>
    <x>390</x>
    <y>691</y>
    <width>95</width>
    <height>15</height>
    <visible>false</visible>
    <off_label>Reset</off_label>
    <off_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </off_color>
    <on_label></on_label>
    <on_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </on_color>
    <show_led>false</show_led>
    <rules>
      <rule name="Show Reset" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0=0 || pv1=0 ||  pv2=0 || pv3=0 || pv4=0">
          <value>true</value>
        </exp>
        <pv_name>$(system)CPLR1AF:Permit</pv_name>
        <pv_name>$(system)CPLR2AF:Permit</pv_name>
        <pv_name>$(system)CPLR3AF:Permit</pv_name>
        <pv_name>$(system)CPLR4AF:Permit</pv_name>
        <pv_name>$(system)CPLR5AF:Permit</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <mode>1</mode>
  </widget>
