<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>SSR2-$(cm) Heat Shield</name>
  <macros>
    <view>Heat Shield</view>
  </macros>
  <width>1300</width>
  <height>850</height>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="picture" version="2.0.0">
    <name>Picture</name>
    <file>../../images/SSR2RadShieldRearView.png</file>
    <x>565</x>
    <y>45</y>
    <width>460</width>
    <height>245</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_20</name>
    <actions>
      <action type="open_display">
        <description>Temperature Table</description>
        <file>SSR2TemperatureTable.bob</file>
        <target>window</target>
        <name>Temperature Table</name>
      </action>
    </actions>
    <text>Temperature Table</text>
    <x>1150</x>
    <y>50</y>
    <width>140</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_1</name>
    <x>565</x>
