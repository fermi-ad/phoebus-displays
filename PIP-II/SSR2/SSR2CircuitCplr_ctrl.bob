  <widget type="action_button" version="3.0.0">
    <name>Action Button_12</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>../Common/cryo-embedded-displays/ValveControlPID2Intlk2PVs.bob</file>
        <macros>
          <Var2>Pressure</Var2>
          <Var1>Pressure</Var1>
          <PV2>PT609</PV2>
          <PV1>PT041</PV1>
          <Intlk2>PT042</Intlk2>
          <Intlk1>RD708</Intlk1>
          <dev>PV609</dev>
          <IntlkCon>1. Rupture Disk RD708: (41 psig)\n2. Cavity High Pressure: (PT042 &gt; 25 psia, reset at 20 psia)</IntlkCon>
          <Notes>2K Return Valve (Pumping Line)</Notes>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text></text>
    <x>162</x>
    <y>291</y>
    <width>69</width>
    <height>83</height>
    <transparent>true</transparent>
