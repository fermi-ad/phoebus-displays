  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>155</x>
    <width>173</width>
    <height>199</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="combo" version="2.0.0">
      <name>Combo Box</name>
      <pv_name>loc://sel("40KSupUT")</pv_name>
      <width>172</width>
      <height>34</height>
      <items>
        <item>5KSupUT</item>
        <item>8KRetUT</item>
        <item>40KSupUT</item>
        <item>80KRetUT</item>
        <item>VLPUT</item>
        <item>HTTSint</item>
        <item>LTTSint</item>
        <item>JTHXHP</item>
        <item>JTHXVLP</item>
        <item>HTTStot</item>
        <item>LTTStot</item>
        <item>VLPtot</item>
        <item>CMtot</item>
        <item>VLPout</item>
        <item>HXVLPmax</item>
        <item>HXHPmax</item>
        <item>5KSupIn</item>
        <item>CMtoHX</item>
      </items>
      <items_from_pv>false</items_from_pv>
    </widget>
    <widget type="embedded" version="2.0.0">
      <name>Embedded Display</name>
      <macros>
        <HLName>40KSupUT</HLName>
        <TempIn>TO612</TempIn>
        <TempOut>TX037A</TempOut>
        <PresIn>PT612</PresIn>
        <PresOut>PT612</PresOut>
      </macros>
      <file>SSR2Cryo_HeatLoadCalcTable.bob</file>
      <y>34</y>
      <width>173</width>
      <height>165</height>
      <scripts>
        <script file="EmbeddedPy" check_connections="false">
          <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
from org.phoebus.framework.macros import Macros

log = ScriptUtil.getLogger()

# circuit : (Pin, Tin, Pout, Tout)
TABLE = {
    "5KSupUT":  ("PT610",  "TO610",  "PT610", "TX030A"),
    "8KRetUT":  ("PT611",  "TX034A", "PT611", "TO611"),
    "40KSupUT": ("PT612",  "TO612",  "PT612", "TX037A"),
    "80KRetUT": ("PT613",  "TX038A", "PT613", "TO613"),
    "VLPUT":    ("PT609",  "TX619",  "PT609", "TX618"),
    "HTTSint":  ("PT612",  "TX037A", "PT613", "TX038A"),
    "LTTSint":  ("PT610",  "TX030A", "PT611", "TX034A"),
    "JTHXHP":   ("PT610",  "TX048",  "PT610", "TX049"),
    "JTHXVLP":  ("PTBath", "TX041",  "PTBath", "TX042"),
    "HTTStot":  ("PT612",  "TO612",  "PT613", "TO613H"),
    "LTTStot":  ("PT610",  "TO610",  "PT611", "TO611"),
    "VLPtot":   ("PT610",  "TO610",  "PT609", "TO609"),
    "CMtot":    ("PT610",  "TX030",  "PT609", "TX043"),
    "VLPout":   ("PTBath", "TX043",  "PT609", "TO609"),
    "HXVLPmax": ("PTBath", "TX041",  "Bath", "TX048"),
    "HXHPmax":  ("PT610",  "TX048",  "PT610", "TX041"),
    "5KSupIn":  ("PT610",  "TO610",  "PT610", "TX048"),
    "CMtoHX":   ("PT610",  "TX030A", "PT610", "TX048"),
}

managed = ["HLName", "PresIn", "TempIn", "PresOut", "TempOut"]

try:
    sel = PVUtil.getString(pvs[0])

    old = widget.getPropertyValue("macros")
    macros = Macros()
    for name in old.getNames():
        if name not in managed:
            macros.add(name, old.getValue(name))

    macros.add("HLName", sel)

    entry = TABLE.get(sel)
    if entry is None:
        log.info("PIP-II/SSR2/SSR2Cryo_HeatLoadCalcs Embedded Table")
        log.warning("no table entry for " + sel)
    else:
        pin, tin, pout, tout = entry
        macros.add("PresIn", pin)
        macros.add("TempIn", tin)
        macros.add("PresOut", pout)
        macros.add("TempOut", tout)

    widget.setPropertyValue("macros", macros)
except Exception as e:
    log.info("PIP-II/SSR2/SSR2Cryo_HeatLoadCalcs Embedded Table")
    log.warning("FAILED: " + str(e))]]></text>
          <pv_name>loc://sel</pv_name>
        </script>
      </scripts>
    </widget>
  </widget>
