<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>SSR2-$(cm)</name>
  <macros>
    <P>PIP2IT:ppSSR2_</P>
    <ghe>PIP2IT:SSR1_CRYO_GHe_</ghe>
    <htr>PIP2IT:SSR1_CRYO_</htr>
    <lhe>PIP2IT:SSR1_CRYO_LHe_</lhe>
    <rf06>PIP2IT:SSR1_HPRF_PLC</rf06>
    <safety>PIP2IT:SSR1_SAFETY_PMT_</safety>
    <temp>PIP2IT:SSR1_CRYO_TEMP_</temp>
    <vac>PIP2IT:SSR1_CRYO_VAC_</vac>
    <view>Overview</view>
    <acc>PIP2IT</acc>
  </macros>
  <width>1300</width>
  <height>830</height>
  <background_color>
    <color name="Button_Background" red="210" green="210" blue="210">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <description>IPMS Selector</description>
        <file>../SSAs/barc-7kw-gui/IPMSselect.bob</file>
        <macros>
          <acc>PIP2IT</acc>
          <cm>ppSSR2</cm>
          <dev>$(acc):$(cm)_HPRF_SSA$(ssa)</dev>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text>SSA Expert Control</text>
    <x>10</x>
    <y>355</y>
    <width>160</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <file>../SSR2/SSR2banner.bob</file>
    <width>1300</width>
    <height>40</height>
  </widget>
  <widget type="picture" version="2.0.0">
    <name>Picture_1</name>
    <file>../../images/SSR2main.png</file>
    <x>360</x>
    <y>175</y>
    <width>500</width>
    <height>185</height>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>1125</x>
    <y>580</y>
    <width>95</width>
    <height>160</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="byte_monitor" version="2.0.0">
      <name>Byte Monitor_5</name>
      <pv_name>$(dev)1_00:ssaModules</pv_name>
      <x>10</x>
      <y>65</y>
      <width>80</width>
      <height>10</height>
      <bitReverse>true</bitReverse>
      <square>true</square>
      <off_color>
        <color name="Off" red="60" green="100" blue="60">
        </color>
      </off_color>
      <on_color>
        <color name="OK" red="0" green="255" blue="0">
        </color>
      </on_color>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_43</name>
      <actions execute_as_one="true">
        <action type="write_pv">
          <description>Safety Reset</description>
          <pv_name>$(rf06)1_RFA:CMD</pv_name>
          <value>4</value>
        </action>
        <action type="write_pv">
          <description>Reset Enable</description>
          <pv_name>$(rf06)1_RFA:CMD</pv_name>
          <value>2</value>
        </action>
        <action type="write_pv">
          <description>Start Enable</description>
          <pv_name>$(rf06)1_RFA:CMD</pv_name>
          <value>0</value>
        </action>
      </actions>
      <text>Ext. Enables</text>
      <x>5</x>
      <y>140</y>
      <width>90</width>
      <height>20</height>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button</name>
      <pv_name>$(dev)1_00:Reset.PROC</pv_name>
      <x>5</x>
      <y>120</y>
      <width>90</width>
      <height>20</height>
      <off_label>Amp Reset</off_label>
      <off_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </off_color>
      <on_label>Amp Reset</on_label>
      <on_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </on_color>
      <show_led>false</show_led>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <mode>1</mode>
      <show_confirm_dialog>2</show_confirm_dialog>
      <confirm_message>Are you sure you want to Reset SSR1-SSA1?</confirm_message>
    </widget>
    <widget type="rectangle" version="2.0.0">
      <name>Rectangle_2</name>
      <x>5</x>
      <width>90</width>
      <height>80</height>
      <line_width>1</line_width>
      <line_color>
        <color red="0" green="0" blue="0">
        </color>
      </line_color>
      <background_color>
        <color name="Grid" red="128" green="128" blue="128">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_32</name>
      <text>SSA1</text>
      <x>5</x>
      <y>40</y>
      <width>90</width>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="BOLD" size="22.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_28</name>
      <text>RF
Enable</text>
      <x>60</x>
      <width>35</width>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="BOLD" size="9.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_33</name>
      <text>Power</text>
      <width>40</width>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="BOLD" size="9.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="multi_state_led" version="2.0.0">
      <name>LED (Multi State)</name>
      <pv_name>$(dev)1_00:OffOn</pv_name>
      <x>10</x>
      <y>20</y>
      <states>
        <state>
          <value>0</value>
          <label></label>
          <color>
            <color name="Off" red="60" green="100" blue="60">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label></label>
          <color>
            <color name="On" red="0" green="255" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>2</value>
          <label></label>
          <color>
            <color name="MAJOR" red="255" green="0" blue="0">
            </color>
          </color>
        </state>
      </states>
      <fallback_label></fallback_label>
    </widget>
    <widget type="multi_state_led" version="2.0.0">
      <name>LED (Multi State)_8</name>
      <pv_name>$(dev)1_00:RFEnable</pv_name>
      <x>70</x>
      <y>20</y>
      <states>
        <state>
          <value>0</value>
          <label></label>
          <color>
            <color name="Off" red="60" green="100" blue="60">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label></label>
          <color>
            <color name="On" red="0" green="255" blue="0">
            </color>
          </color>
        </state>
      </states>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_20</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>SSR2-SSA.bob</file>
          <macros>
            <ssa>1</ssa>
          </macros>
          <target>tab</target>
        </action>
      </actions>
      <text></text>
      <x>5</x>
      <width>90</width>
      <height>80</height>
      <transparent>true</transparent>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button_5</name>
      <pv_name>$(dev)1_00:setOffOn</pv_name>
      <x>5</x>
      <y>100</y>
      <width>90</width>
      <height>20</height>
      <off_label>Power On</off_label>
      <off_color>
        <color name="STOP" red="255" green="0" blue="0">
        </color>
      </off_color>
      <on_label>Power Off</on_label>
      <show_led>false</show_led>
      <actions>
      </actions>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <show_confirm_dialog>1</show_confirm_dialog>
      <confirm_message>Are you sure you want to Start or Stop SSR1-SSA1?</confirm_message>
    </widget>
    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button_7</name>
      <pv_name>$(dev)1_00:setRFEnable</pv_name>
      <x>5</x>
      <y>80</y>
      <width>90</width>
      <height>20</height>
      <off_label>RF Enable</off_label>
      <off_color>
        <color name="STOP" red="255" green="0" blue="0">
        </color>
      </off_color>
      <on_label>RF Disable</on_label>
      <show_led>false</show_led>
      <actions>
      </actions>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <show_confirm_dialog>2</show_confirm_dialog>
      <confirm_message>Are you sure you want to Enable RF for SSR1-SSA1?</confirm_message>
    </widget>
  </widget>
