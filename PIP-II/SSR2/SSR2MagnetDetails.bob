      <widget type="byte_monitor" version="2.0.0">
        <name>Byte Monitor_112</name>
        <pv_name>$(hprf)SSA$(cav):Status</pv_name>
        <width>20</width>
        <height>160</height>
        <startBit>8</startBit>
        <bitReverse>true</bitReverse>
        <horizontal>false</horizontal>
        <square>true</square>
        <off_color>
