<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>SSR2 Magnet Details</name>
  <width>720</width>
  <height>510</height>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>PIP2IT ppSSR2 Solonoid $(mag)</text>
    <width>720</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <background_color>
      <color name="SSR2color" red="254" green="209" blue="65">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <border_width>2</border_width>
  </widget>
  <widget type="picture" version="2.0.0">
    <name>Picture_1</name>
    <file>../../images/SSR2/SSR2Magnet.png</file>
    <x>220</x>
    <y>120</y>
    <width>265</width>
    <height>380</height>
    <rotation>180.0</rotation>
  </widget>
  <widget type="polyline" version="2.0.0">
    <name>Polyline_115</name>
    <x>385</x>
    <y>375</y>
    <width>20</width>
    <height>50</height>
    <points>
      <point x="20.0" y="50.0">
      </point>
      <point x="0.0" y="0.0">
      </point>
    </points>
    <line_color>
      <color name="OK" red="0" green="255" blue="0">
      </color>
    </line_color>
    <arrows>2</arrows>
    <arrow_length>7</arrow_length>
  </widget>
  <widget type="polyline" version="2.0.0">
    <name>Polyline_118</name>
    <x>390</x>
    <y>155</y>
    <width>20</width>
    <height>65</height>
    <points>
      <point x="20.0" y="0.0">
      </point>
      <point x="0.0" y="65.0">
      </point>
    </points>
    <line_color>
      <color name="OK" red="0" green="255" blue="0">
      </color>
    </line_color>
    <arrows>2</arrows>
    <arrow_length>7</arrow_length>
  </widget>
  <widget type="ellipse" version="2.0.0">
    <name>Ellipse_7</name>
    <x>380</x>
    <y>358</y>
    <width>10</width>
    <height>10</height>
    <line_width>2</line_width>
    <line_color>
      <color name="OK" red="0" green="255" blue="0">
      </color>
    </line_color>
    <background_color>
      <color red="255" green="255" blue="255">
      </color>
    </background_color>
  </widget>
  <widget type="ellipse" version="2.0.0">
    <name>Ellipse_1</name>
    <x>380</x>
    <y>223</y>
    <width>10</width>
    <height>10</height>
    <line_width>2</line_width>
    <line_color>
      <color name="OK" red="0" green="255" blue="0">
      </color>
    </line_color>
    <background_color>
      <color red="255" green="255" blue="255">
      </color>
    </background_color>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>485</x>
    <y>325</y>
    <width>30</width>
    <height>50</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_187</name>
      <pv_name>$(system)HTRCLP$(mag):Name</pv_name>
      <width>15</width>
      <height>60</height>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="11.0">
        </font>
      </font>
      <foreground_color>
        <color red="237" green="185" blue="185">
        </color>
      </foreground_color>
      <background_color>
        <color red="44" green="44" blue="44">
        </color>
      </background_color>
      <precision>2</precision>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <rotation_step>1</rotation_step>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_1</name>
      <actions>
        <action type="open_display">
          <description>Open Heater Display</description>
          <file>../Common/cryo-embedded-displays/HeaterCtrlCoupler.bob</file>
          <macros>
            <dev>HTRC$(cav)</dev>
          </macros>
          <target>window</target>
        </action>
      </actions>
      <text></text>
      <width>30</width>
      <height>50</height>
      <transparent>true</transparent>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="polyline" version="2.0.0">
      <name>Polyline_91</name>
      <x>15</x>
      <y>3</y>
      <width>10</width>
      <height>45</height>
      <visible>false</visible>
      <points>
        <point x="5.0" y="0.0">
        </point>
        <point x="5.0" y="2.5">
        </point>
        <point x="0.0" y="5.0">
        </point>
        <point x="10.0" y="10.0">
        </point>
        <point x="0.0" y="15.0">
        </point>
        <point x="10.0" y="20.0">
        </point>
        <point x="0.0" y="25.0">
        </point>
        <point x="10.0" y="30.0">
        </point>
        <point x="0.0" y="35.0">
        </point>
        <point x="10.0" y="40.0">
        </point>
        <point x="5.0" y="42.5">
        </point>
        <point x="5.0" y="45.0">
        </point>
      </points>
      <line_color>
        <color red="255" green="0" blue="0">
        </color>
      </line_color>
      <arrow_length>10</arrow_length>
      <rules>
        <rule name="Heater On" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0">
            <value>true</value>
          </exp>
          <pv_name>$(system)HTRCLP$(mag):HTRON</pv_name>
        </rule>
      </rules>
    </widget>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_15</name>
    <macros>
      <sensor>TX$(cav)02</sensor>
    </macros>
    <file>../Common/cryo-embedded-displays/TempSensorDown.bob</file>
    <x>385</x>
    <y>425</y>
    <width>65</width>
    <height>35</height>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_16</name>
    <macros>
      <sensor>TX$(cav)01</sensor>
