  <widget type="stripchart" version="2.1.0">
    <name>Strip Chart</name>
    <x>250</x>
    <y>64</y>
    <width>700</width>
    <height>250</height>
    <background_color>
      <color red="242" green="242" blue="242">
      </color>
    </background_color>
    <show_grid>true</show_grid>
    <title>Sensor Voltage</title>
    <title_font>
      <font family="Liberation Sans" style="REGULAR" size="14.0">
      </font>
    </title_font>
    <label_font>
      <font family="Liberation Sans" style="REGULAR" size="14.0">
      </font>
    </label_font>
    <show_toolbar>false</show_toolbar>
    <show_legend>true</show_legend>
    <start>5 minute</start>
    <y_axes>
      <y_axis>
        <title>Volts</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>true</show_grid>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <y_pv>$(system):voltage</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color name="acorn.Green" red="82" green="171" blue="90">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
