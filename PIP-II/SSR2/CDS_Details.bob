  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>86</x>
    <y>645</y>
    <width>70</width>
    <height>30</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_217</name>
      <pv_name>$(flow)2FTSUMK2K3:Flow</pv_name>
      <width>70</width>
      <height>15</height>
      <font>
        <font family="Liberation Sans" style="BOLD" size="11.0">
        </font>
      </font>
      <foreground_color>
        <color name="Write_Background" red="128" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="44" green="44" blue="44">
        </color>
      </background_color>
      <precision>3</precision>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
      <rules>
        <rule name="View Lower Range Flow" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0&lt;=10.0">
            <value>true</value>
          </exp>
          <pv_name>$(flow)FT600A:GHeFlow</pv_name>
        </rule>
        <rule name="Show units" prop_id="show_units" out_exp="false">
          <exp bool_exp="pv0&lt;=10.0">
            <value>true</value>
          </exp>
          <pv_name>$(flow)FT600A:GHeFlow</pv_name>
        </rule>
      </rules>
      <border_width>1</border_width>
      <border_color>
        <color name="Write_Background" red="128" green="255" blue="255">
        </color>
      </border_color>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_218</name>
      <pv_name>$(flow)2FTSUMK2K3:Name</pv_name>
      <y>15</y>
