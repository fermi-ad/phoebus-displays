        <description>Open Leybold TD20</description>
        <file>../Common/vacuum-embedded-displays/LeyboldTD20.bob</file>
        <macros>
          <P>$(system)</P>
          <R>PT052</R>
        </macros>
        <target>window</target>
      </action>
    </actions>
    <text></text>
    <x>515</x>
    <y>155</y>
    <width>50</width>
    <height>50</height>
    <transparent>true</transparent>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
