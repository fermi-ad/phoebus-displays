  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>../Common/cryo-embedded-displays/ValveControlPID2Intlk2PVs.bob</file>
        <macros>
          <dev>PV617</dev>
          <PV1>FT600A</PV1>
          <Var1>GHeFlow</Var1>
          <PV2>TO613H</PV2>
          <Var2>Temp</Var2>
          <Intlk1>PT623_612</Intlk1>
          <Intlk2>TEMP_MAX</Intlk2>
          <IntlkCon>1. HTTS Diff Pressure: (PT623 - PT612 &gt; 0 psid, &amp; PV625 open)\n2. HTTS Diff Temperature: (absolute dT between max(TX037A, TX038A, TX060, TX061, TX062, TX063, TX064, TX066, TX067, TX068 and TX069) and min(TX037A, TX038A, TX060, TX061, TX062, TX063, TX064, TX066, TX067, TX068 and TX069))</IntlkCon>
          <Notes>80K Return (HTTS) Cooldown Valve to Compressor Suction</Notes>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text></text>
    <x>825</x>
    <y>262</y>
    <width>69</width>
    <height>83</height>
    <transparent>true</transparent>
