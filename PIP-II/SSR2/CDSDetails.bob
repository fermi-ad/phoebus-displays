  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>ValveControlPID2Intlk2PVs.bob</file>
        <macros>
          <dev>PV617</dev>
          <PV1>FT600A</PV1>
          <Var1>GHeFlow</Var1>
          <PV2>TO613H</PV2>
          <Var2>Temp</Var2>
          <Intlk1>PT623_612</Intlk1>
          <Intlk2>TEMP_MAX</Intlk2>
          <IntlkCon>1. HTTS Diff Pressure (PT623 - PT612 &gt; 0 psid, &amp; PV625 open)  2. HTTS Diff Temperature (absolute difference between max(TX035A, TX036A, TX060, and TX064) and min(max(TX035A, &lt;80K=80K), max(TX036A, &lt;80K=80K), max(TX060, &lt;80K=80K, and max(TX064, &lt;80K=80K)))</IntlkCon>
          <Notes>80K Return (HTTS) Cooldown Valve to Compressor Suction</Notes>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text></text>
    <x>393</x>
    <y>195</y>
    <width>69</width>
    <height>83</height>
    <transparent>true</transparent>
    <tooltip>$(actions)</tooltip>
  </widget>
