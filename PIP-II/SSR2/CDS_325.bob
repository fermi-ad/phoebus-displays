        </font>
      </font>
      <foreground_color>
        <color name="Write_Background" red="128" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="44" green="44" blue="44">
        </color>
      </background_color>
      <precision>2</precision>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
      <rules>
        <rule name="View Lower Range Flow" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0&lt;=10.0">
            <value>true</value>
          </exp>
          <pv_name>$(flow)FT600A:GHeFlow</pv_name>
