      <rules>
        <rule name="Show" prop_id="name" out_exp="false">
          <exp bool_exp="pv0&gt;=0.1">
            <value>Action Button_7</value>
          </exp>
          <pv_name>sim://sine</pv_name>
        </rule>
      </rules>
