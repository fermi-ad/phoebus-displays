<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>$(dev): Valve Control</name>
  <width>500</width>
  <height>375</height>
  <background_color>
    <color name="cryo.PrimaryBackground" red="217" green="217" blue="217">
    </color>
  </background_color>
  <widget type="polyline" version="2.0.0">
    <name>Polyline_105</name>
    <x>786</x>
    <y>87</y>
    <width>45</width>
    <height>10</height>
    <visible>false</visible>
    <points>
      <point x="0.0" y="5.0">
      </point>
      <point x="2.5" y="5.0">
      </point>
      <point x="5.0" y="0.0">
      </point>
      <point x="10.0" y="10.0">
      </point>
      <point x="15.0" y="0.0">
      </point>
      <point x="20.0" y="10.0">
      </point>
      <point x="25.0" y="0.0">
      </point>
      <point x="30.0" y="10.0">
      </point>
      <point x="35.0" y="0.0">
      </point>
      <point x="40.0" y="10.0">
      </point>
      <point x="42.5" y="5.0">
      </point>
      <point x="45.0" y="5.0">
      </point>
    </points>
    <line_color>
      <color red="255" green="0" blue="0">
      </color>
    </line_color>
    <arrow_length>10</arrow_length>
    <rules>
      <rule name="Heater On" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0">
          <value>true</value>
        </exp>
        <pv_name>$(htr)HTRVSL:HTRON</pv_name>
      </rule>
    </rules>
  </widget>
