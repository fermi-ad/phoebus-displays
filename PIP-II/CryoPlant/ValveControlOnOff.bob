  <widget type="label" version="2.0.0">
    <name>$(dev): Valve Control</name>
    <text>$(dev): Valve Control</text>
    <width>500</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="fgs.NAL-Blue" red="0" green="76" blue="151">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_width>1</border_width>
  </widget>
  <widget type="symbol" version="2.0.0">
    <name>Symbol_25</name>
    <pv_name>$(system)$(dev):VLVstat</pv_name>
    <symbols>
      <symbol>../Images/Cryo/OnOffValveGray.svg</symbol>
      <symbol>../Images/Cryo/OnOffValveGreen.svg</symbol>
      <symbol>../Images/Cryo/OnOffValveRed.svg</symbol>
    </symbols>
    <x>152</x>
    <y>221</y>
    <width>170</width>
    <height>150</height>
    <tooltip>$(pv_name)
$(pv_value)
$(actions)</tooltip>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED</name>
    <pv_name>$(system)$(dev):LimOpen</pv_name>
    <x>311</x>
    <y>172</y>
    <width>30</width>
    <height>30</height>
    <off_color>
      <color red="115" green="115" blue="115">
      </color>
    </off_color>
    <on_color>
      <color name="acorn.Green" red="82" green="171" blue="90">
      </color>
    </on_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>VALVE OPEN LIMIT SWITCH</text>
    <x>111</x>
    <y>178</y>
    <width>190</width>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED_1</name>
    <pv_name>$(system)$(dev):LimClosed</pv_name>
    <x>311</x>
    <y>212</y>
    <width>30</width>
    <height>30</height>
    <off_color>
      <color red="115" green="115" blue="115">
      </color>
    </off_color>
    <on_color>
      <color name="acorn.Green" red="82" green="171" blue="90">
      </color>
    </on_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>VALVE CLOSED LIMIT SWITCH</text>
    <x>87</x>
    <y>218</y>
    <width>214</width>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="tank" version="2.0.0">
    <name>Tank</name>
    <x>648</x>
    <y>304</y>
    <width>1</width>
    <height>1</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Close</name>
    <actions>
      <action type="write_pv">
        <description>Close Valve</description>
        <pv_name>$(pv_name)</pv_name>
        <value>0</value>
      </action>
    </actions>
    <pv_name>$(system)$(dev):sOpen</pv_name>
    <text>CLOSE $(dev)</text>
    <x>94</x>
    <y>79</y>
    <width>122</width>
    <height>64</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>OPEN</name>
    <actions>
      <action type="write_pv">
        <description>Open Valve</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(system)$(dev):sOpen</pv_name>
    <text>OPEN $(dev)</text>
    <x>241</x>
    <y>78</y>
    <width>122</width>
    <height>64</height>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED_2</name>
    <pv_name>$(system)$(dev):Open</pv_name>
    <x>199</x>
    <y>82</y>
    <width>15</width>
    <height>15</height>
    <off_color>
      <color name="acorn.Green" red="82" green="171" blue="90">
      </color>
    </off_color>
    <on_color>
      <color name="fgs.Gray-45" red="167" green="168" blue="170">
      </color>
    </on_color>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED_3</name>
    <pv_name>$(system)$(dev):Open</pv_name>
    <x>345</x>
    <y>82</y>
    <width>15</width>
    <height>15</height>
    <off_color>
      <color name="fgs.Gray-45" red="167" green="168" blue="170">
      </color>
    </off_color>
    <on_color>
      <color name="acorn.Green" red="82" green="171" blue="90">
      </color>
    </on_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_1</name>
    <pv_name>sys://time</pv_name>
    <x>401</x>
    <width>91</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="fgs.NAL-Blue" red="0" green="76" blue="151">
      </color>
    </background_color>
    <transparent>true</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
</display>
