<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Cryoplant ODH</name>
  <macros>
    <complex>CP</complex>
    <system>$(complex):ODH_$(group)_</system>
    <group>ESH</group>
  </macros>
  <width>1400</width>
  <height>500</height>
  <background_color>
    <color red="217" green="217" blue="217">
    </color>
  </background_color>
  <widget type="label" version="2.0.0">
    <name>Cryo Storage and Recovery</name>
    <text>PIP-II Cryoplant ODH Overview</text>
    <width>1400</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="fgs.NAL-Blue" red="0" green="76" blue="151">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <border_width>1</border_width>
  </widget>
  <widget type="picture" version="2.0.0">
    <name>Picture</name>
    <file>../Images/Cryo/png/CPBuildingLayout.png</file>
    <y>89</y>
    <width>1378</width>
    <height>372</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>CryoPlantMain.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>HOME</text>
    <x>1295</x>
    <y>4</y>
    <width>89</width>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <tooltip>$(actions)</tooltip>
  </widget>
