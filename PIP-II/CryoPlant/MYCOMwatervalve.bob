  <widget type="action_button" version="3.0.0">
    <name>Close</name>
    <actions>
      <action type="write_pv">
        <description>Switch to HEATX</description>
        <pv_name>$(pv_name)</pv_name>
        <value>0</value>
      </action>
    </actions>
    <pv_name>$(system)$(enum):PVSelect</pv_name>
    <text>HEATX</text>
    <x>280</x>
    <y>100</y>
    <width>160</width>
    <height>64</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>OPEN</name>
    <actions>
      <action type="write_pv">
        <description>Switch to MNFLD</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(system)$(enum):PVSelect</pv_name>
    <text>MNFLD</text>
    <x>450</x>
    <y>100</y>
    <width>160</width>
    <height>64</height>
    <rules>
      <rule name="New Rule" prop_id="background_color" out_exp="false">
        <exp bool_exp="new exp == 1">
          <value>
            <color name="Button_Background" red="210" green="210" blue="210">
            </color>
          </value>
        </exp>
        <pv_name>$(pv_name)</pv_name>
      </rule>
    </rules>
  </widget>
