      <rule name="Change Color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>
            <color name="cryo.On" red="82" green="171" blue="90">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0 == 0">
          <value>
            <color name="fgs.Gray-45" red="167" green="168" blue="170">
            </color>
          </value>
        </exp>
        <pv_name>CP:MYCOM_CRYO_PLC062:rBIT</pv_name>
      </rule>
    </rules>
  </widget>
