  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>CryoRecoverySystem.bob</file>
        <macros>
          <complex>PIP2CP:</complex>
          <vlv>$(complex):RECOVERYSYSTEM</vlv>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text>Storage and Recovery</text>
    <x>204</x>
    <y>175</y>
    <width>235</width>
    <height>48</height>
    <tooltip>$(actions)</tooltip>
  </widget>
