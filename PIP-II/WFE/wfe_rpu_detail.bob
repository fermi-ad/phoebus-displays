  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>InfoPanel</name>
    <x>20</x>
    <y>56</y>
    <width>890</width>
    <height>64</height>
    <line_width>1</line_width>
    <line_color>
      <color red="217" green="222" blue="227" />
