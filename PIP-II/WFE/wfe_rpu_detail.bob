  <widget type="label" version="2.0.0">
    <name>Info</name>
    <text>This scaffold detail view focuses on the RPU devices. The live differential-current rows below are IOC-side calc records derived from adjacent device current readbacks so we can review the operator flow before the final hardware behavior is defined.</text>
    <x>20</x>
    <y>56</y>
    <width>860</width>
    <height>52</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <wrap_words>true</wrap_words>
    <vertical_alignment>1</vertical_alignment>
    <actions />
    <foreground_color>
      <color red="89" green="102" blue="115" />
    </foreground_color>
    <transparent>true</transparent>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Back</name>
    <actions>
      <action type="open_display">
        <file>wfe_main.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Back to WFE Overview</text>
