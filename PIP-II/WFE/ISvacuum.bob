    <name>LED (Multi State)</name>
    <pv_name>A0TST:IS_BLE_$(dev):HBstatus</pv_name>
    <x>70</x>
    <y>5</y>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
    <states>
      <state>
        <value>0</value>
        <label>OK</label>
        <color>
          <color name="Off" red="60" green="100" blue="60">
          </color>
        </color>
      </state>
      <state>
        <value>1</value>
        <label>OK</label>
        <color>
          <color name="On" red="0" green="255" blue="0">
          </color>
        </color>
      </state>
    </states>
    <fallback_color>
      <color name="MAJOR" red="255" green="0" blue="0">
      </color>
    </fallback_color>
  </widget>
