<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>WFE Scraper Detail</name>
  <width>1560</width>
  <height>980</height>
  <background_color>
    <color red="245" green="247" blue="250" />
  </background_color>
  <widget type="label" version="2.0.0">
    <name>Header</name>
    <text>WFE Scraper Detail</text>
    <x>0</x>
    <y>0</y>
    <width>1560</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="24.0" />
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255" />
    </foreground_color>
    <background_color>
