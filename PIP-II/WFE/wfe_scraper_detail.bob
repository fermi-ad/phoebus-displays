    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <actions />
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>InfoPanel</name>
    <x>20</x>
    <y>56</y>
    <width>980</width>
    <height>64</height>
    <line_width>1</line_width>
    <line_color>
      <color red="217" green="222" blue="227" />
    </line_color>
    <background_color>
      <color red="255" green="255" blue="255" />
    </background_color>
    <transparent>false</transparent>
    <actions />
  </widget>
  <widget type="label" version="2.0.0">
    <name>Info</name>
    <text>This scaffold detail view focuses on the 16 scraper devices arranged as 4 locations with Top, Bottom, Left, and Right scrapers at each location. Position, location, and bias readbacks stay visible so the operator layout can mature before the final hardware interface is locked.</text>
    <x>24</x>
    <y>58</y>
    <width>950</width>
    <height>52</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <wrap_words>true</wrap_words>
    <vertical_alignment>1</vertical_alignment>
    <horizontal_alignment>0</horizontal_alignment>
    <foreground_color>
      <color red="89" green="102" blue="115" />
    </foreground_color>
    <transparent>true</transparent>
    <actions />
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Back</name>
    <text>Back to WFE Overview</text>
    <x>1280</x>
    <y>62</y>
    <width>220</width>
    <height>34</height>
    <actions>
      <action type="open_display">
        <file>wfe_main.bob</file>
