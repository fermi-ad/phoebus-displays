  <widget type="label" version="2.0.0">
    <name>Foot</name>
    <text>This screen now reflects the 16-scraper scaffold grouped as 4 locations with Top, Bottom, Left, and Right devices at each location. The grouping is operator-facing only: the underlying PV bindings remain per scraper device (SCRP01 through SCRP16), so we can refine labels or lattice ordering later without changing the IOC-side record pattern.</text>
    <x>24</x>
    <y>907</y>
    <width>1490</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <wrap_words>true</wrap_words>
    <vertical_alignment>1</vertical_alignment>
    <foreground_color>
      <color red="89" green="102" blue="115" />
    </foreground_color>
    <transparent>true</transparent>
    <actions />
  </widget>
