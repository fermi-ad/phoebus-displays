<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Ion Source</name>
  <macros>
    <complex>A0TST</complex>
    <sys>IS</sys>
    <group>BLE</group>
    <system>$(complex):$(sys)_$(group)_</system>
    <dev>HVPLC</dev>
  </macros>
  <width>940</width>
  <height>870</height>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Ion Source</text>
    <width>940</width>
    <height>30</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <background_color>
      <color red="128" green="128" blue="0">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_6</name>
    <pv_name>$(system)PLC2W7:wBIT</pv_name>
    <x>585</x>
    <y>130</y>
    <width>175</width>
    <off_label>Reset All</off_label>
    <off_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </off_color>
    <on_label>Reset Bias</on_label>
    <on_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </on_color>
    <show_led>false</show_led>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <mode>1</mode>
    <confirm_message></confirm_message>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_7</name>
    <pv_name>$(system)PLC2W6:wBIT</pv_name>
    <bit>6</bit>
    <x>585</x>
    <y>160</y>
    <width>175</width>
    <off_label>480V Contactor</off_label>
    <off_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </off_color>
    <on_label>480V Contactor</on_label>
    <on_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </on_color>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <show_confirm_dialog>2</show_confirm_dialog>
    <confirm_message>Are your sure you want to turn on 480V?</confirm_message>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>HV PLC</text>
    <x>5</x>
    <y>5</y>
    <width>60</width>
    <horizontal_alignment>2</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="multi_state_led" version="2.0.0">
    <name>LED (Multi State)</name>
    <pv_name>$(system)$(dev):HBstatus</pv_name>
    <x>70</x>
    <y>5</y>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
    <states>
      <state>
        <value>0</value>
        <label>OK</label>
        <color>
          <color name="Off" red="60" green="100" blue="60">
          </color>
        </color>
      </state>
      <state>
        <value>1</value>
        <label>OK</label>
        <color>
          <color name="On" red="0" green="255" blue="0">
          </color>
        </color>
      </state>
    </states>
    <fallback_color>
      <color name="MAJOR" red="255" green="0" blue="0">
      </color>
    </fallback_color>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <x>10</x>
    <y>445</y>
    <width>926</width>
    <height>420</height>
    <style>3</style>
    <transparent>true</transparent>
