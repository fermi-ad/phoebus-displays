<commands>
  <set>
    <device>pva://A0TST:IS_BLE_ARC:sVoltage</device>
    <value>122.0</value>
    <wait>false</wait>
    <tolerance>0.1</tolerance>
  </set>
  <wait>
    <device>pva://A0TST:IS_BLE_ARC:Voltage</device>
    <value>122.0</value>
    <comparison>EQUALS</comparison>
    <tolerance>1.0</tolerance>
  </wait>
  <loop>
    <device>pva://A0TST:IS_BLE_FLMNT:sCurrent</device>
    <start>10.0</start>
    <end>200.0</end>
    <step>10.0</step>
    <wait>false</wait>
    <tolerance>1.0</tolerance>
    <body>
      <delay>
        <seconds>5.0</seconds>
      </delay>
    </body>
  </loop>
  <set>
    <device>pva://A0TST:IS_BLE_ARC:sCurrent</device>
    <value>5.0</value>
    <wait>false</wait>
    <tolerance>0.1</tolerance>
  </set>
  <while>
    <device>pva://A0TST:IS_BLE_ARC:Current</device>
    <value>5.0</value>
    <comparison>BELOW</comparison>
    <tolerance>0.1</tolerance>
    <tolerance>0.1</tolerance>
    <body>
      <script>
        <path>Increment</path>
        <arguments>
          <argument>pva://A0TST:IS_BLE_FLMNT:sCurrent</argument>
          <argument>2</argument>
        </arguments>
      </script>
      <delay>
        <seconds>5.0</seconds>
      </delay>
    </body>
  </while>
</commands>
